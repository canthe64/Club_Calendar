@page "/"
@* App.razor's <Routes @rendermode="InteractiveServer" /> prerenders every page by default, which
   means OnInitializedAsync below would otherwise run twice per load (once at prerender, again once
   the circuit connects) - silently doubling the Graph calls this page makes. This page has no
   interactive elements at all, so there's nothing prerendering buys it; disabling it here removes
   the duplicate pass entirely. Found live 2026-08-04 as the cause of a noticed slowdown on this page. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.Graph
@using FacilityScheduler.Services
@inject GraphServiceClient GraphClient
@inject FacilityConfiguration Facility

<PageTitle>Facility Scheduler - Connectivity Check</PageTitle>

<h1>Facility Scheduler</h1>
<p>Graph connectivity check against the @Mailboxes.Length resource mailboxes.</p>

@if (_results is null)
{
    <p><em>Checking...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Mailbox</th>
                <th>Status</th>
                <th>Detail</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var result in _results)
            {
                <tr>
                    <td>@result.Mailbox</td>
                    <td>@result.Status</td>
                    <td>@result.Detail</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<MailboxCheckResult>? _results;

    private string[] Mailboxes => [.. Facility.SheetMailboxes, Facility.ClubEventsMailbox];

    protected override async Task OnInitializedAsync()
    {
        // Fanned out in parallel (same pattern as SheetBookingService.GetBookingsForAllSheetsAsync)
        // rather than one mailbox at a time - this page was doing N sequential Graph round-trips
        // (5 sheets + Club Events), and Task.WhenAll preserves Mailboxes' own order regardless of
        // which call actually finishes first, so the table's row order stays stable.
        var results = await Task.WhenAll(Mailboxes.Select(CheckMailboxAsync));
        _results = [.. results];
    }

    private async Task<MailboxCheckResult> CheckMailboxAsync(string mailbox)
    {
        try
        {
            var calendar = await GraphClient.Users[mailbox].Calendar.GetAsync();
            return new MailboxCheckResult(mailbox, "OK", $"Calendar name: {calendar?.Name}");
        }
        catch (Exception ex)
        {
            return new MailboxCheckResult(mailbox, "FAILED", ex.Message);
        }
    }

    private sealed record MailboxCheckResult(string Mailbox, string Status, string Detail);
}
