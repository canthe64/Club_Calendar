@page "/calendar"
@page "/"
@using FacilityScheduler.Domain
@using FacilityScheduler.Services
@using FacilityScheduler.Components.Calendar
@inject SheetBookingService BookingService
@inject ClubEventService ClubEventService
@inject AuthenticationStateProvider AuthProvider
@inject FacilityConfiguration Facility

<PageTitle>Calendar</PageTitle>

<div style="padding:16px 24px">
    <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-bottom:10px">
        <span style="font-size:16px;font-weight:600;color:#1e2a33">@AnchorLabel</span>
        <span style="display:flex;align-items:center;gap:8px;font-size:14px;color:#1e2a33">
            <span @onclick="GoPrevious" style="cursor:pointer;color:#2d5f8a;font-weight:600;padding:0 5px">&#8249;</span>
            <span @onclick="GoToday" style="cursor:pointer;color:#2d5f8a;font-weight:600;padding:0 5px">Today</span>
            <span @onclick="GoNext" style="cursor:pointer;color:#2d5f8a;font-weight:600;padding:0 5px">&#8250;</span>
        </span>
        @* Jump straight to a date instead of stepping a month at a time. The browser's own date
           picker rather than a custom popup calendar - it's keyboard-accessible and localised for
           free, and this is the authenticated app so there's no D15 constraint against it. Bound
           straight to the anchor date, so it also *reflects* where you are as you use ‹/Today/›. *@
        <input type="date" @bind="_anchorDate" @bind:after="LoadAsync" aria-label="Jump to date"
               style="border:1px solid #d7dfe5;border-radius:6px;padding:5px 9px;font-size:13px;color:#1e2a33;font-family:inherit;cursor:pointer" />
        <div style="display:flex;border:1px solid #d7dfe5;border-radius:6px;overflow:hidden;font-size:13px;font-weight:600;margin-left:auto;cursor:pointer">
            <span @onclick='() => SetView(ViewMode.Month)' style="padding:6px 16px;background:@(View == ViewMode.Month ? "#2d5f8a" : "#fff");color:@(View == ViewMode.Month ? "#fff" : "#2d5f8a")">Month</span>
            <span @onclick='() => SetView(ViewMode.Week)' style="padding:6px 16px;background:@(View == ViewMode.Week ? "#2d5f8a" : "#fff");color:@(View == ViewMode.Week ? "#fff" : "#2d5f8a")">Week</span>
            <span @onclick='() => SetView(ViewMode.Day)' style="padding:6px 16px;background:@(View == ViewMode.Day ? "#2d5f8a" : "#fff");color:@(View == ViewMode.Day ? "#fff" : "#2d5f8a")">Day</span>
        </div>
        <div style="position:relative">
            <span @onclick="ToggleNewMenu" style="background:#c62f2f;color:#fff;padding:8px 15px;border-radius:6px;font-weight:600;font-size:13.5px;cursor:pointer;display:inline-flex;align-items:center;gap:5px">
                + New Booking <span style="font-size:10px">&#9662;</span>
            </span>
            @if (_newMenuOpen)
            {
                <div style="position:absolute;top:100%;left:0;margin-top:4px;background:#fff;border:1px solid #d7dfe5;border-radius:6px;box-shadow:0 6px 18px rgba(0,0,0,.15);z-index:20;min-width:170px;overflow:hidden">
                    <div @onclick="SelectNewBooking" style="padding:9px 15px;font-size:13.5px;font-weight:600;color:#1e2a33;cursor:pointer">New Booking</div>
                    <div @onclick="SelectNewSeries" style="padding:9px 15px;font-size:13.5px;font-weight:600;color:#1e2a33;cursor:pointer;border-top:1px solid #f2f5f7">New Series</div>
                    <div @onclick="SelectNewClubEvent" style="padding:9px 15px;font-size:13.5px;font-weight:600;color:#1e2a33;cursor:pointer;border-top:1px solid #f2f5f7">New Club Event</div>
                </div>
            }
        </div>
        <a href="/club-events" style="border:1px solid #d7dfe5;color:#2d5f8a;padding:8px 15px;border-radius:6px;font-weight:600;font-size:13.5px;cursor:pointer;text-decoration:none">Club Events</a>
    </div>

    <div style="background:#fff;border-bottom:1px solid #e2e8ec;padding:9px 0;display:flex;align-items:center;gap:8px;font-size:13px;flex-wrap:wrap;margin-bottom:12px">
        <span style="font-weight:600;color:#90a0ab;font-size:12px;letter-spacing:.05em">SHOW</span>
        @foreach (var cat in CalendarStyles.SheetCategories)
        {
            var isOn = _selectedCategories.Contains(cat);
            <span @onclick="() => ToggleCategory(cat)"
                  style="border:1px solid @CalendarStyles.CategoryColor(cat);color:@(isOn ? "#fff" : CalendarStyles.CategoryColor(cat));background:@(isOn ? CalendarStyles.CategoryColor(cat) : "#fff");padding:4px 12px;border-radius:12px;font-weight:600;cursor:pointer">
                @CalendarStyles.CategoryLabel(cat)
            </span>
        }
        <span @onclick="() => _showClubEvents = !_showClubEvents" style="margin-left:auto;display:flex;align-items:center;gap:6px;color:#1e2a33;font-weight:600;cursor:pointer">
            <input type="checkbox" checked="@_showClubEvents" style="pointer-events:none" /> Show club events
        </span>
    </div>

    @if (_loading)
    {
        <p><em>Loading...</em></p>
    }
    else if (View == ViewMode.Month)
    {
        <MonthGrid Bookings="FilteredBookings" ClubEvents="VisibleClubEvents" AnchorMonth="_anchorDate" OnBookingClick="OpenDetail" OnClubEventClick="OpenClubEventDetail" OnDayClick="JumpToDay" />
    }
    else if (View == ViewMode.Week)
    {
        <WeekGrid Bookings="FilteredBookings" ClubEvents="VisibleClubEvents" WeekStart="WeekStart" OnBookingClick="OpenDetail" OnClubEventClick="OpenClubEventDetail" OnDayClick="JumpToDay" />
    }
    else
    {
        <DayGrid Bookings="FilteredBookings" ClubEvents="VisibleClubEvents" Date="_anchorDate" OnBookingClick="OpenDetail" OnClubEventClick="OpenClubEventDetail" OnSlotClick="OpenSlotForm" />
    }
</div>

<BookingFormModal IsOpen="_formOpen" Draft="_draft" Conflicts="_formConflicts" IsSaving="_isSaving" OnSave="SaveDraft" OnCancel="CloseForm" />
<ClubEventFormModal IsOpen="_clubEventFormOpen" Draft="_clubEventDraft" IsSaving="_isSavingClubEvent" OnSave="SaveClubEventDraft" OnCancel="CloseClubEventForm" OnDelete="DeleteClubEventDraft" />
<ClubEventDetailModal ClubEvent="_clubEventDetail" OnClose="() => _clubEventDetail = null" OnEdit="StartEditClubEvent" OnDelete="DeleteClubEventDirect" />
<BookingDetailModal Group="_detailGroup" OnClose="() => _detailGroup = null" OnEdit="StartEdit" OnCancelBooking="StartCancel" OnCancelSeries="StartCancelSeries" OnEditSeries="StartEditSeries" />
<SeriesEditModal Group="_seriesEditGroup" Conflicts="_seriesEditConflicts" IsSaving="_isSavingSeriesEdit" OnSave="SaveSeries" OnCancel="CloseSeriesEdit" />
<CancelChoiceModal Group="_cancelGroup" OnChoice="ApplyCancelChoice" OnKeep="() => _cancelGroup = null" />
<SeriesWizardModal IsOpen="_seriesWizardOpen" Draft="_seriesDraft" Step="_seriesStep" Conflicts="_seriesConflicts"
                    IsLoadingPreview="_isLoadingSeriesPreview" IsSaving="_isSavingSeries"
                    OnPreview="PreviewSeries" OnBack="() => _seriesStep = 1" OnCreate="CreateSeries" OnCancel="CloseSeriesWizard" />

@if (_cancelSeriesGroup is not null)
{
    <div style="position:fixed;inset:0;background:rgba(30,42,51,.55);display:flex;align-items:center;justify-content:center;z-index:60">
        <div style="background:#fff;border-radius:10px;box-shadow:0 12px 32px rgba(0,0,0,.4);padding:18px 20px;width:380px">
            <div style="font-size:14px;font-weight:600;color:#1e2a33;margin-bottom:4px">Cancel the entire series?</div>
            <div style="font-size:11px;color:#5a7183;margin-bottom:12px">This deletes every occurrence, past and future, on every sheet involved - not just this one date. Meant for correcting a data-entry mistake, not routine cancellations.</div>
            <div style="display:flex;flex-direction:column;gap:7px;font-size:11.5px;font-weight:600">
                <span @onclick="ConfirmCancelSeries" style="border:1px solid #e8b4ae;color:#a02c21;border-radius:6px;padding:8px 12px;text-align:center;cursor:pointer">Yes, cancel the entire series</span>
                <span @onclick="() => _cancelSeriesGroup = null" style="text-align:center;color:#90a0ab;padding:4px 0;cursor:pointer">Never mind</span>
            </div>
        </div>
    </div>
}

@code {
    private enum ViewMode { Month, Week, Day }

    private ViewMode View = ViewMode.Month;

    // Placeholder only, overwritten in OnInitializedAsync - a field initializer runs before Blazor
    // sets @inject properties, so Facility.Today isn't available here yet.
    private DateTime _anchorDate = DateTime.MinValue;
    private List<SheetBooking> _allBookings = [];
    private List<ClubEvent> _activeClubEvents = [];
    private bool _newMenuOpen;
    private bool _loading = true;

    private readonly HashSet<BookingCategory> _selectedCategories = [.. CalendarStyles.SheetCategories];
    private bool _showClubEvents = true;

    private bool _formOpen;
    private BookingDraft _draft = new();
    private List<SheetBooking> _formConflicts = [];
    private bool _isSaving;

    private bool _clubEventFormOpen;
    private ClubEventDraft _clubEventDraft = new();
    private bool _isSavingClubEvent;
    private ClubEvent? _clubEventDetail;

    private List<SheetBooking>? _detailGroup;
    private List<SheetBooking>? _seriesEditGroup;
    private List<SheetBooking> _seriesEditConflicts = [];
    private bool _isSavingSeriesEdit;
    private List<SheetBooking>? _cancelGroup;
    private List<SheetBooking>? _cancelSeriesGroup;

    private bool _seriesWizardOpen;
    private int _seriesStep = 1;
    private SeriesDraft _seriesDraft = new();
    private Dictionary<DateTime, List<SheetBooking>> _seriesConflicts = [];
    private bool _isLoadingSeriesPreview;
    private bool _isSavingSeries;

    private DateTime WeekStart => _anchorDate.Date.AddDays(-(int)_anchorDate.DayOfWeek);

    private List<SheetBooking> FilteredBookings => _allBookings
        .Where(b => _selectedCategories.Contains(b.Category))
        .ToList();

    private List<ClubEvent> VisibleClubEvents => _showClubEvents ? _activeClubEvents : [];

    private string AnchorLabel => View switch
    {
        ViewMode.Month => _anchorDate.ToString("MMMM yyyy"),
        ViewMode.Week => $"{WeekStart:MMM d} - {WeekStart.AddDays(6):MMM d, yyyy}",
        _ => _anchorDate.ToString("dddd, MMMM d, yyyy")
    };

    protected override async Task OnInitializedAsync()
    {
        _anchorDate = Facility.Today;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        var (start, end) = View switch
        {
            ViewMode.Month => (MonthGridStart(_anchorDate), MonthGridEnd(_anchorDate).AddDays(1)),
            ViewMode.Week => (WeekStart, WeekStart.AddDays(7)),
            _ => (_anchorDate.Date, _anchorDate.Date.AddDays(1))
        };

        _allBookings = await BookingService.GetBookingsForAllSheetsAsync(start, end);
        _activeClubEvents = await ClubEventService.GetEventsAsync(start, end);
        _loading = false;
    }


    private static DateTime MonthGridStart(DateTime anchor)
    {
        var firstOfMonth = new DateTime(anchor.Year, anchor.Month, 1);
        return firstOfMonth.AddDays(-(int)firstOfMonth.DayOfWeek);
    }

    private static DateTime MonthGridEnd(DateTime anchor)
    {
        var lastOfMonth = new DateTime(anchor.Year, anchor.Month, 1).AddMonths(1).AddDays(-1);
        return lastOfMonth.AddDays(6 - (int)lastOfMonth.DayOfWeek);
    }

    private async Task SetView(ViewMode mode)
    {
        View = mode;
        await LoadAsync();
    }

    private async Task GoPrevious()
    {
        _anchorDate = View switch
        {
            ViewMode.Month => _anchorDate.AddMonths(-1),
            ViewMode.Week => _anchorDate.AddDays(-7),
            _ => _anchorDate.AddDays(-1)
        };
        await LoadAsync();
    }

    private async Task GoNext()
    {
        _anchorDate = View switch
        {
            ViewMode.Month => _anchorDate.AddMonths(1),
            ViewMode.Week => _anchorDate.AddDays(7),
            _ => _anchorDate.AddDays(1)
        };
        await LoadAsync();
    }

    private async Task GoToday()
    {
        _anchorDate = Facility.Today;
        await LoadAsync();
    }

    private async Task JumpToDay(DateTime day)
    {
        _anchorDate = day.Date;
        View = ViewMode.Day;
        await LoadAsync();
    }

    private void ToggleCategory(BookingCategory cat)
    {
        if (!_selectedCategories.Remove(cat))
        {
            _selectedCategories.Add(cat);
        }
    }

    private void OpenDetail(SheetBooking booking)
    {
        // A Guid.Empty BookingGroupId isn't a real, shared identity - it's the default for an
        // untouched occurrence of a recurring series (the property only reliably persists once an
        // occurrence has been individually PATCHed, e.g. via an edit; live-confirmed 2026-07-16).
        // Matching on it directly would risk bundling this booking with a completely unrelated one
        // that happens to share the same empty default AND the same start/end time by coincidence -
        // treat it as a lone booking instead of guessing at siblings.
        if (booking.BookingGroupId == Guid.Empty)
        {
            _detailGroup = [booking];
            return;
        }

        // Scoped by date/time as well as group id - a multi-week recurring series shares one
        // BookingGroupId across every occurrence, and Month view can have several weeks of the
        // same series loaded at once. Without this, clicking one occurrence could pull in other
        // weeks' occurrences too. WeekGrid/MonthGrid already filter by date before grouping chips;
        // this brings the detail lookup in line with that.
        _detailGroup = _allBookings.Where(b => b.BookingGroupId == booking.BookingGroupId && b.Start == booking.Start && b.End == booking.End).ToList();
    }

    private void ToggleNewMenu() => _newMenuOpen = !_newMenuOpen;

    private void SelectNewBooking()
    {
        _newMenuOpen = false;
        OpenCreateForm();
    }

    private void SelectNewSeries()
    {
        _newMenuOpen = false;
        OpenSeriesWizard();
    }

    private void SelectNewClubEvent()
    {
        _newMenuOpen = false;
        OpenCreateClubEventForm();
    }

    // Anchored on _anchorDate (what's currently in view), not Facility.Today - same spirit as
    // OpenCreateForm's use of _anchorDate for a new single booking. The standalone Club Events
    // page's own "+ New Club Event" has no "currently in view" concept, so it anchors on today
    // instead - that's a different, equally correct default for a different context.
    private void OpenCreateClubEventForm()
    {
        _clubEventDraft = new ClubEventDraft();
        _clubEventDraft.Reset(_anchorDate);
        _clubEventFormOpen = true;
    }

    private void OpenCreateForm()
    {
        _draft = new BookingDraft();
        _draft.Reset(Facility.Today, initialStart: _anchorDate.AddHours(18));
        _formConflicts = [];
        _formOpen = true;
    }

    private void OpenSlotForm((string Sheet, DateTime Start) slot)
    {
        _draft = new BookingDraft();
        _draft.Reset(Facility.Today, initialSheets: [slot.Sheet], initialStart: slot.Start);
        _formConflicts = [];
        _formOpen = true;
    }

    private void StartEdit(List<SheetBooking> group)
    {
        _detailGroup = null;
        _draft = new BookingDraft();
        _draft.LoadForEdit(group);
        _formConflicts = [];
        _formOpen = true;
    }

    private void StartCancel(List<SheetBooking> group)
    {
        _detailGroup = null;
        _cancelGroup = group;
    }

    private void StartEditSeries(List<SheetBooking> group)
    {
        _detailGroup = null;
        _seriesEditConflicts = [];
        _seriesEditGroup = group;
    }

    private void CloseSeriesEdit()
    {
        _seriesEditGroup = null;
        _seriesEditConflicts = [];
    }

    /// <summary>
    /// Whole-series save. Unlike SaveDraft there is no time to validate and no closure check to run:
    /// the series already occupies these times, and this edit can't move them - the only thing that
    /// can newly collide is a sheet being added, which UpdateSeriesAsync checks across every
    /// occurrence and refuses as a whole.
    /// </summary>
    private async Task SaveSeries(SeriesEditModal.SeriesEdit edit)
    {
        if (_seriesEditGroup is null || _isSavingSeriesEdit)
        {
            return;
        }

        _isSavingSeriesEdit = true;
        _seriesEditConflicts = [];
        StateHasChanged();

        try
        {
            var actingUser = await GetCurrentUserNameAsync();
            var result = await BookingService.UpdateSeriesAsync(
                _seriesEditGroup,
                new SheetBooking
                {
                    SheetMailbox = "",
                    Start = default,
                    End = default,
                    Category = edit.Category,
                    State = _seriesEditGroup[0].State,
                    RenterName = edit.RenterName,
                    RenterPhone = _seriesEditGroup[0].RenterPhone,
                    RenterEmail = _seriesEditGroup[0].RenterEmail,
                    Notes = edit.Notes
                },
                edit.Sheets,
                actingUser);

            if (!result.IsSuccess)
            {
                _seriesEditConflicts = result.Conflicts.ToList();
                return;
            }

            CloseSeriesEdit();
            await LoadAsync();
        }
        finally
        {
            _isSavingSeriesEdit = false;
        }
    }

    private void CloseForm()
    {
        _formOpen = false;
        _formConflicts = [];
    }

    private async Task SaveDraft()
    {
        var canSave = _draft.Category.HasValue
            && _draft.SelectedSheets.Count > 0
            && !string.IsNullOrWhiteSpace(_draft.RenterName)
            && _draft.End > _draft.Start
            && (_draft.Category != BookingCategory.GroupEvent || _draft.CreateAsConfirmed.HasValue);

        if (_isSaving || !canSave)
        {
            return;
        }

        _isSaving = true;
        StateHasChanged();

        try
        {
            var closures = await GetActiveClosuresAsync(_draft.Start, _draft.End);
            if (closures.Count > 0)
            {
                _formConflicts = closures.Select(ClosureConflict).ToList();
                return;
            }

            var bookedBy = await GetCurrentUserNameAsync();
            var newState = _draft.CreateAsConfirmed == true ? BookingState.Confirmed : BookingState.Hold;

            if (_draft.EditingGroup is null)
            {
                var template = new SheetBooking
                {
                    SheetMailbox = "", // overwritten per-sheet inside CreateAcrossSheetsAsync
                    Start = _draft.Start,
                    End = _draft.End,
                    Category = _draft.Category!.Value,
                    State = newState,
                    RenterName = _draft.RenterName,
                    RenterPhone = _draft.RenterPhone,
                    RenterEmail = _draft.RenterEmail,
                    Notes = _draft.Notes,
                    BookedBy = bookedBy
                };

                var result = await BookingService.CreateAcrossSheetsAsync(_draft.SelectedSheets, template, bookedBy);
                if (result.IsSuccess)
                {
                    CloseForm();
                    await LoadAsync();
                }
                else
                {
                    _formConflicts = result.Conflicts;
                }
            }
            else
            {
                var updatedFields = new SheetBooking
                {
                    SheetMailbox = "",
                    Start = _draft.Start,
                    End = _draft.End,
                    Category = _draft.Category!.Value,
                    State = newState,
                    RenterName = _draft.RenterName,
                    RenterPhone = _draft.RenterPhone,
                    RenterEmail = _draft.RenterEmail,
                    Notes = _draft.Notes,
                    BookedBy = bookedBy
                };

                var membersToUpdate = _draft.EditingGroup.Where(m => _draft.SelectedSheets.Contains(m.SheetMailbox)).ToList();
                var newSheets = _draft.SelectedSheets.Except(_draft.EditingGroup.Select(m => m.SheetMailbox)).ToList();

                // Deselecting a sheet leaves it untouched (still part of whatever it was before -
                // e.g. an open rental hold). If that leaves it behind, it needs to split off into
                // its own BookingGroupId - otherwise it'd still show grouped with the sheets that
                // ARE being updated here, displaying the wrong renter/state when clicked. Also mint a
                // fresh group id whenever a member currently has none (Guid.Empty - an untouched
                // recurring occurrence, see OpenDetail) so an edit gives it a real, persisted identity
                // instead of writing Guid.Empty right back.
                var isPartialEdit = membersToUpdate.Count < _draft.EditingGroup.Count;
                var needsFreshGroupId = isPartialEdit || membersToUpdate.Any(m => m.BookingGroupId == Guid.Empty);
                var splitGroupId = needsFreshGroupId ? Guid.NewGuid() : (Guid?)null;

                var result = await BookingService.UpdateGroupAsync(membersToUpdate, updatedFields, bookedBy, newSheets, splitGroupId);
                if (result.IsSuccess)
                {
                    CloseForm();
                    await LoadAsync();
                }
                else
                {
                    _formConflicts = result.Conflicts;
                }
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task ApplyCancelChoice(bool reopenAsGroupEventHold)
    {
        if (_cancelGroup is null)
        {
            return;
        }

        var actingUser = await GetCurrentUserNameAsync();
        await BookingService.CancelGroupAsync(_cancelGroup, reopenAsGroupEventHold, actingUser);
        _cancelGroup = null;
        await LoadAsync();
    }

    private async Task<string> GetCurrentUserNameAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        return authState.User.Identity?.Name ?? "Unknown";
    }

    private void OpenSeriesWizard()
    {
        _seriesDraft = new SeriesDraft();
        _seriesDraft.Reset(Facility.Today);
        _seriesConflicts = [];
        _seriesStep = 1;
        _seriesWizardOpen = true;
    }

    private void CloseSeriesWizard()
    {
        _seriesWizardOpen = false;
        _seriesStep = 1;
        _seriesConflicts = [];
    }

    private async Task PreviewSeries()
    {
        _isLoadingSeriesPreview = true;
        StateHasChanged();

        try
        {
            var candidateDates = _seriesDraft.ComputeCandidateDates();
            _seriesConflicts = await BookingService.PreviewSeriesConflictsAsync(
                _seriesDraft.SelectedSheets,
                candidateDates,
                TimeSpan.FromMinutes(_seriesDraft.StartMinutes),
                TimeSpan.FromMinutes(_seriesDraft.EndMinutes));

            if (candidateDates.Count > 0)
            {
                // One fetch across the whole candidate window, then filtered per-date locally -
                // same shape as PreviewSeriesConflictsAsync's own sheet-conflict check, just for
                // closure club events instead of sheet bookings. Informational only, same as every
                // other series-preview conflict: staff choose whether to skip that date.
                var rangeStart = candidateDates.Min().Date;
                var rangeEnd = candidateDates.Max().Date.AddDays(1);
                var closures = await GetActiveClosuresAsync(rangeStart, rangeEnd);

                foreach (var date in candidateDates)
                {
                    var slotStart = date.Date.AddMinutes(_seriesDraft.StartMinutes);
                    var slotEnd = date.Date.AddMinutes(_seriesDraft.EndMinutes);
                    var overlapping = closures.Where(ce => ce.Start < slotEnd && ce.End > slotStart).ToList();
                    if (overlapping.Count == 0)
                    {
                        continue;
                    }

                    if (!_seriesConflicts.TryGetValue(date, out var existing))
                    {
                        existing = [];
                        _seriesConflicts[date] = existing;
                    }

                    existing.AddRange(overlapping.Select(ClosureConflict));
                }
            }

            _seriesStep = 2;
        }
        finally
        {
            _isLoadingSeriesPreview = false;
        }
    }

    /// <summary>Club events with MarksSheetsUnavailable overlapping [start,end) - checked separately
    /// from SheetBookingService's own conflicts since ClubEventService is deliberately decoupled from
    /// it (architecture doc D13, no direct dependency between the two services); this page is where
    /// the two get cross-checked.</summary>
    private async Task<List<ClubEvent>> GetActiveClosuresAsync(DateTime start, DateTime end)
    {
        var events = await ClubEventService.GetEventsAsync(start.Date, end.Date.AddDays(1));
        return events.Where(ce => ce.MarksSheetsUnavailable && ce.Start < end && ce.End > start).ToList();
    }

    private static SheetBooking ClosureConflict(ClubEvent ce) => new()
    {
        SheetMailbox = "", // signals "not a real sheet" to the conflict-rendering UI
        Start = ce.Start,
        End = ce.End,
        Category = BookingCategory.Other,
        State = BookingState.Confirmed,
        RenterName = ce.Title,
    };

    private void OpenClubEventDetail(ClubEvent ce)
    {
        _clubEventDetail = ce;
    }

    private void StartEditClubEvent(ClubEvent ce)
    {
        _clubEventDetail = null;
        _clubEventDraft = new ClubEventDraft();
        _clubEventDraft.LoadForEdit(ce);
        _clubEventFormOpen = true;
    }

    private void CloseClubEventForm()
    {
        _clubEventFormOpen = false;
    }

    private async Task DeleteClubEventDirect(ClubEvent ce)
    {
        _clubEventDetail = null;
        if (ce.EventId is null)
        {
            return;
        }

        var actingUser = await GetCurrentUserNameAsync();
        await ClubEventService.CancelAsync(ce.EventId, actingUser);
        await LoadAsync();
    }

    private async Task SaveClubEventDraft()
    {
        var canSave = _clubEventDraft.Category.HasValue
            && !string.IsNullOrWhiteSpace(_clubEventDraft.Title)
            && (_clubEventDraft.IsAllDay ? _clubEventDraft.EndDate.Date >= _clubEventDraft.StartDate.Date : _clubEventDraft.End > _clubEventDraft.Start);

        if (_isSavingClubEvent || !canSave)
        {
            return;
        }

        _isSavingClubEvent = true;
        StateHasChanged();

        try
        {
            var bookedBy = await GetCurrentUserNameAsync();
            var clubEvent = _clubEventDraft.ToClubEvent(bookedBy);

            if (_clubEventDraft.EditingEvent is null)
            {
                await ClubEventService.CreateAsync(clubEvent, bookedBy);
            }
            else
            {
                await ClubEventService.UpdateAsync(clubEvent, bookedBy);
            }

            CloseClubEventForm();
            await LoadAsync();
        }
        finally
        {
            _isSavingClubEvent = false;
        }
    }

    private async Task DeleteClubEventDraft()
    {
        if (_clubEventDraft.EditingEvent?.EventId is null)
        {
            return;
        }

        var actingUser = await GetCurrentUserNameAsync();
        await ClubEventService.CancelAsync(_clubEventDraft.EditingEvent.EventId, actingUser);
        CloseClubEventForm();
        await LoadAsync();
    }

    private async Task CreateSeries()
    {
        var canCreate = _seriesDraft.Category.HasValue
            && _seriesDraft.SelectedSheets.Count > 0
            && !string.IsNullOrWhiteSpace(_seriesDraft.RenterName)
            && _seriesDraft.EndMinutes > _seriesDraft.StartMinutes
            && (_seriesDraft.Category != BookingCategory.GroupEvent || _seriesDraft.CreateAsConfirmed.HasValue);

        if (_isSavingSeries || !canCreate)
        {
            return;
        }

        _isSavingSeries = true;
        StateHasChanged();

        try
        {
            var bookedBy = await GetCurrentUserNameAsync();
            var template = new SheetBooking
            {
                SheetMailbox = "", // overwritten per-sheet inside CreateSeriesAsync
                Start = _seriesDraft.FirstOccurrenceStart,
                End = _seriesDraft.FirstOccurrenceEnd,
                Category = _seriesDraft.Category!.Value,
                State = _seriesDraft.CreateAsConfirmed == true ? BookingState.Confirmed : BookingState.Hold,
                RenterName = _seriesDraft.RenterName,
                RenterPhone = _seriesDraft.RenterPhone,
                RenterEmail = _seriesDraft.RenterEmail,
                Notes = _seriesDraft.Notes,
                BookedBy = bookedBy
            };

            await BookingService.CreateSeriesAsync(_seriesDraft.SelectedSheets, template, _seriesDraft.LastDate, _seriesDraft.SkippedDates, bookedBy);
            CloseSeriesWizard();
            await LoadAsync();
        }
        finally
        {
            _isSavingSeries = false;
        }
    }

    private void StartCancelSeries(List<SheetBooking> group)
    {
        _detailGroup = null;
        _cancelSeriesGroup = group;
    }

    private async Task ConfirmCancelSeries()
    {
        if (_cancelSeriesGroup is null)
        {
            return;
        }

        var actingUser = await GetCurrentUserNameAsync();
        await BookingService.CancelSeriesAsync(_cancelSeriesGroup, actingUser);
        _cancelSeriesGroup = null;
        await LoadAsync();
    }
}
