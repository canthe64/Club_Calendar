@page "/schedule"
@using FacilityScheduler.Domain
@using FacilityScheduler.Services
@inject SheetBookingService BookingService
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Schedule</PageTitle>

<h1>Schedule</h1>

<div class="controls">
    <label>
        Sheet:
        <select @bind="SelectedSheet" @bind:after="LoadBookingsAsync">
            @foreach (var sheet in Sheets.All)
            {
                <option value="@sheet">@sheet</option>
            }
        </select>
    </label>

    <button @onclick="PreviousDay">&lt; Prev</button>
    <span>@SelectedDate.ToString("dddd, MMMM d, yyyy")</span>
    <button @onclick="NextDay">Next &gt;</button>

    <button @onclick="() => _showCreateForm = true">+ New booking</button>
</div>

@if (_showCreateForm)
{
    <div class="create-form">
        <h3>New booking</h3>
        <EditForm Model="_newBooking" OnValidSubmit="CreateBookingAsync">
            <div>
                <label>Start: <InputDate Type="InputDateType.DateTimeLocal" @bind-Value="_newBooking.Start" /></label>
            </div>
            <div>
                <label>End: <InputDate Type="InputDateType.DateTimeLocal" @bind-Value="_newBooking.End" /></label>
            </div>
            <div>
                <label>
                    Category:
                    <InputSelect @bind-Value="_newBooking.Category">
                        @foreach (var c in Enum.GetValues<BookingCategory>())
                        {
                            <option value="@c">@c</option>
                        }
                    </InputSelect>
                </label>
            </div>
            <div>
                <label><InputCheckbox @bind-Value="_createAsConfirmed" /> Create as confirmed (not a hold)</label>
            </div>
            <div>
                <label>Renter name: <InputText @bind-Value="_newBooking.RenterName" /></label>
            </div>
            <div>
                <label>Contact: <InputText @bind-Value="_newBooking.RenterContact" /></label>
            </div>
            <div>
                <label>Price: <InputNumber @bind-Value="_newBooking.Price" /></label>
            </div>
            <div>
                <label>Notes: <InputTextArea @bind-Value="_newBooking.Notes" /></label>
            </div>
            <button type="submit">Create</button>
            <button type="button" @onclick="() => _showCreateForm = false">Cancel</button>
        </EditForm>

        @if (_conflicts.Count > 0)
        {
            <div class="conflicts">
                <strong>Conflict - slot not available:</strong>
                <ul>
                    @foreach (var c in _conflicts)
                    {
                        <li>@c.Start.ToString("h:mm tt") - @c.End.ToString("h:mm tt"): @c.Category (@c.State)</li>
                    }
                </ul>
            </div>
        }
    </div>
}

@if (_bookings is null)
{
    <p><em>Loading...</em></p>
}
else if (_bookings.Count == 0)
{
    <p>No bookings for this sheet on this day.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Time</th>
                <th>Category</th>
                <th>State</th>
                <th>Renter</th>
                <th>Price</th>
                <th>Booked by</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in _bookings.OrderBy(b => b.Start))
            {
                <tr style="background-color: @CategoryColor(booking.Category)">
                    <td>@booking.Start.ToString("h:mm tt") - @booking.End.ToString("h:mm tt")</td>
                    <td>@booking.Category</td>
                    <td>
                        <span style="font-weight: @(booking.State == BookingState.Confirmed ? "bold" : "normal")">
                            @booking.State
                        </span>
                    </td>
                    <td>@booking.RenterName</td>
                    <td>@(booking.Price?.ToString("C"))</td>
                    <td>@booking.BookedBy</td>
                    <td>
                        @if (booking.State == BookingState.Hold)
                        {
                            <button @onclick="() => ConfirmBookingAsync(booking)">Confirm</button>
                        }
                        <button @onclick="() => CancelBookingAsync(booking)">Cancel</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private string SelectedSheet { get; set; } = Sheets.All[0];
    private DateTime SelectedDate { get; set; } = DateTime.UtcNow.Date;
    private List<SheetBooking>? _bookings;
    private bool _showCreateForm;
    private bool _createAsConfirmed;
    private List<SheetBooking> _conflicts = [];
    private NewBookingModel _newBooking = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadBookingsAsync();
    }

    private async Task LoadBookingsAsync()
    {
        _bookings = await BookingService.GetBookingsAsync(SelectedSheet, SelectedDate, SelectedDate.AddDays(1));
    }

    private async Task PreviousDay()
    {
        SelectedDate = SelectedDate.AddDays(-1);
        await LoadBookingsAsync();
    }

    private async Task NextDay()
    {
        SelectedDate = SelectedDate.AddDays(1);
        await LoadBookingsAsync();
    }

    private async Task<string> GetCurrentUserNameAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        return authState.User.Identity?.Name ?? "Unknown";
    }

    private async Task CreateBookingAsync()
    {
        _conflicts = [];
        var bookedBy = await GetCurrentUserNameAsync();

        var booking = new SheetBooking
        {
            SheetMailbox = SelectedSheet,
            Start = _newBooking.Start,
            End = _newBooking.End,
            Category = _newBooking.Category,
            State = BookingState.Hold,
            RenterName = _newBooking.RenterName,
            RenterContact = _newBooking.RenterContact,
            Price = _newBooking.Price,
            Notes = _newBooking.Notes,
            BookedBy = bookedBy
        };

        var result = _createAsConfirmed
            ? await BookingService.CreateConfirmedAsync(booking)
            : await BookingService.CreateHoldAsync(booking);

        if (result.IsSuccess)
        {
            _showCreateForm = false;
            _newBooking = new();
            _createAsConfirmed = false;
            await LoadBookingsAsync();
        }
        else
        {
            _conflicts = result.Conflicts;
        }
    }

    private async Task ConfirmBookingAsync(SheetBooking booking)
    {
        if (booking.EventId is null) return;
        await BookingService.ConfirmAsync(booking.SheetMailbox, booking.EventId);
        await LoadBookingsAsync();
    }

    private async Task CancelBookingAsync(SheetBooking booking)
    {
        if (booking.EventId is null) return;
        await BookingService.CancelAsync(booking.SheetMailbox, booking.EventId);
        await LoadBookingsAsync();
    }

    // App's own color mapping, independent of Exchange's category colors (architecture doc S4.1
    // design rule) - chosen to echo the same colors picked for the Outlook master category list
    // for familiarity, but this mapping is not derived from Exchange in any way.
    private static string CategoryColor(BookingCategory category) => category switch
    {
        BookingCategory.Rental => "#d4f4dd", // light green
        BookingCategory.League => "#d6ecfb", // sky blue
        BookingCategory.Event => "#fbd6ea",  // pink
        BookingCategory.Other => "#e8e0f5",  // lavender
        _ => "#ffffff"
    };

    private sealed class NewBookingModel
    {
        public DateTime Start { get; set; } = DateTime.UtcNow.Date.AddHours(18);
        public DateTime End { get; set; } = DateTime.UtcNow.Date.AddHours(20);
        public BookingCategory Category { get; set; } = BookingCategory.Rental;
        public string? RenterName { get; set; }
        public string? RenterContact { get; set; }
        public decimal? Price { get; set; }
        public string? Notes { get; set; }
    }
}
