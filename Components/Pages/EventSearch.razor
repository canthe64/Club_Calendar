@page "/search"
@using FacilityScheduler.Domain
@using FacilityScheduler.Domain.Search
@* Alias so every existing ResultRow reference in this file (fields, OpenResult's parameter) keeps
   working unchanged - the type itself moved to SearchResultsBuilder when the CSV export needed the
   exact same match/group/sort logic the screen already used. *@
@using ResultRow = FacilityScheduler.Domain.Search.SearchResultsBuilder.ResultRow
@using FacilityScheduler.Services
@using FacilityScheduler.Components.Calendar
@inject SheetBookingService BookingService
@inject ClubEventService ClubEventService
@inject FacilityConfiguration Facility
@inject SchedulingWindowService Window
@inject NavigationManager Navigation

<PageTitle>Search</PageTitle>

<div style="padding:16px 24px">
    <div style="display:flex;align-items:center;gap:14px;margin-bottom:14px">
        <span style="font-size:18px;font-weight:600;color:#1e2a33">Event Search</span>
        <span style="font-size:15px;color:#90a0ab">Find any event by day, category, or title.</span>
    </div>

    <div style="display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap;margin-bottom:6px">
        <div style="flex:1;min-width:260px">
            <div style="font-weight:600;color:#1e2a33;margin-bottom:3px;font-size:13px">Search</div>
            <input value="@_query" @oninput="OnQueryInput" @onkeydown="OnQueryKeyDown"
                   placeholder="category:bonspiel day:saturday junior..."
                   style="border:1px solid #d7dfe5;border-radius:6px;padding:7px 10px;font-size:13.5px;width:100%;box-sizing:border-box">
        </div>
        <div style="opacity:@(_searchEntireSeason ? "0.5" : "1")">
            <div style="font-weight:600;color:#1e2a33;margin-bottom:3px;font-size:13px">Start date</div>
            <input type="date" value="@_rangeStart?.ToString("yyyy-MM-dd")" @onchange="OnRangeStartChanged" disabled="@_searchEntireSeason"
                   style="border:1px solid #d7dfe5;border-radius:6px;padding:6px 9px;font-size:13.5px">
        </div>
        <div style="opacity:@(_searchEntireSeason ? "0.5" : "1")">
            <div style="font-weight:600;color:#1e2a33;margin-bottom:3px;font-size:13px">End date</div>
            <input type="date" value="@_rangeEnd?.ToString("yyyy-MM-dd")" @onchange="OnRangeEndChanged" disabled="@_searchEntireSeason"
                   style="border:1px solid #d7dfe5;border-radius:6px;padding:6px 9px;font-size:13.5px">
        </div>
        <span @onclick="RunSearch" title="@(SearchBlocked ? BlockMessage : null)"
              style="background:@(_isSearching || SearchBlocked ? "#e8b4ae" : "#c62f2f");color:#fff;padding:8px 18px;border-radius:6px;font-weight:600;font-size:13.5px;cursor:@(_isSearching || SearchBlocked ? "default" : "pointer");white-space:nowrap">
            @(_isSearching ? "Searching…" : "Search")
        </span>
        @* A plain <a>, not an @onclick handler - a file download has to be a real HTTP response, and
           routing it through the SignalR circuit is the wrong tool (same reasoning as
           SettingsLogsEndpoint's log download). Disabled by omitting href until a search has actually
           run, rather than always present and erroring on an empty query. Exports the FULL match set,
           not just what's on screen - MaxRenderedRows is a render-cost cap, not a real result limit. *@
        @if (_hasSearched && (_upcoming.Count > 0 || _past.Count > 0))
        {
            <a href="@ExportUrl" title="Download every matching result as a CSV file"
               style="border:1px solid #2d5f8a;color:#2d5f8a;padding:8px 18px;border-radius:6px;font-weight:600;font-size:13.5px;white-space:nowrap;text-decoration:none">
                Export CSV
            </a>
        }
    </div>
    @* "Entire season" bypasses the 60-day cap entirely (SearchRange.ResolveSeason, D111) - added for
       the report a 60-day-at-a-time search can't produce without stitching several searches/exports
       together by hand: every instance of one event across a whole season. Start/End grey out above
       while this is checked since they're not consulted at all - RunSearch reads the operator's
       configured season instead (Window.SeasonStartDate/SeasonEndDate, Settings page). *@
    <div style="display:flex;align-items:center;gap:6px;margin-bottom:6px;font-size:12.5px;color:#5a7183">
        <input type="checkbox" id="search-entire-season" @bind="_searchEntireSeason" disabled="@SeasonNotConfigured" style="cursor:pointer;margin:0">
        <label for="search-entire-season" style="font-weight:600;color:#1e2a33;cursor:pointer">Search entire season</label>
        @if (SeasonNotConfigured)
        {
            <span>— no booking season is configured (set one on the Settings page to use this)</span>
        }
        else
        {
            <span>
                — @Window.SeasonStartDate!.Value.ToString("MMM d, yyyy") to @Window.SeasonEndDate!.Value.ToString("MMM d, yyyy"),
                bypassing the @SearchRange.MaxSpanDays-day window below. A full-season search reads far more
                data than usual and <strong>may take a long time</strong> to complete.
            </span>
        }
    </div>
    @* Always visible, not just on the help card - this used to only mention the day cap before the
       first search, which is exactly when it matters least. Switches to a specific, actionable
       message the moment the picked dates would be blocked, rather than letting a guaranteed-to-be-
       clamped search be attempted and explained after the fact. *@
    <div style="font-size:12px;margin-bottom:4px;font-weight:@(SearchBlocked ? "600" : "400");color:@(SearchBlocked ? "#a02c21" : "#90a0ab")">
        @(SearchBlocked ? BlockMessage : _searchEntireSeason ? "Searching the entire configured season." : $"Searches up to {SearchRange.MaxSpanDays} days at a time.")
    </div>
    <div style="font-size:12px;color:#90a0ab;margin-bottom:14px">
        Searches titles and categories only - not phone numbers, email, or notes. Those still show once you open a result.
    </div>

    @* See ResolveViewState's own doc comment for the real bug this fixed: the spinner used to be
       unreachable on the very first search of a page load. *@
    @if (ResolveViewState(_isSearching, _hasSearched) == SearchViewState.Searching)
    {
        <p><em>Searching @Facility.SheetMailboxes.Length sheets over @((_lastResolvedEnd - _lastResolvedStart).Days) days…</em></p>
    }
    else if (ResolveViewState(_isSearching, _hasSearched) == SearchViewState.Idle)
    {
        <div style="background:#f6f8f9;border:1px solid #e7ecef;border-radius:8px;padding:14px 16px;font-size:13.5px;color:#5a7183;max-width:640px">
            <div style="font-weight:600;color:#1e2a33;margin-bottom:8px">Search syntax</div>
            <div style="display:flex;flex-direction:column;gap:5px">
                <div><code style="background:#eef1f3;padding:1px 6px;border-radius:4px">category:bonspiel</code> - matches a category, e.g. league, bonspiel, practiceice, closure</div>
                <div><code style="background:#eef1f3;padding:1px 6px;border-radius:4px">day:saturday</code> - a day of the week (full name or 3-letter abbreviation)</div>
                <div><code style="background:#eef1f3;padding:1px 6px;border-radius:4px">type:on-ice</code> / <code style="background:#eef1f3;padding:1px 6px;border-radius:4px">type:off-ice</code> - restrict to one kind</div>
                <div>any other word matches the title, e.g. <code style="background:#eef1f3;padding:1px 6px;border-radius:4px">smith wedding</code></div>
            </div>
            <div style="margin-top:8px;color:#90a0ab">
                Terms combine with AND; multiple <code style="background:#eef1f3;padding:1px 6px;border-radius:4px">day:</code> or <code style="background:#eef1f3;padding:1px 6px;border-radius:4px">category:</code> terms combine with OR (<code style="background:#eef1f3;padding:1px 6px;border-radius:4px">day:saturday day:sunday</code> means the weekend).
                <code style="background:#eef1f3;padding:1px 6px;border-radius:4px">category:bonspiel</code> matches both the on-ice category and the off-ice category "Out of Town Bonspiels" - add <code style="background:#eef1f3;padding:1px 6px;border-radius:4px">type:on-ice</code> to narrow.
            </div>
            <div style="margin-top:8px;color:#90a0ab">
                The date range covers at most @SearchRange.MaxSpanDays days at a time - move Start/End
                forward to search further out, or check "Search entire season" above for a full-season
                report in one pass.
            </div>
        </div>
    }
    else
    {
        @if (_notices.Count > 0)
        {
            <div style="display:flex;flex-direction:column;gap:4px;margin-bottom:8px">
                @foreach (var notice in _notices)
                {
                    <div style="background:#fdf8ec;border:1px solid #f0d58c;color:#8a6d1f;border-radius:6px;padding:6px 10px;font-size:12.5px">@notice.Message</div>
                }
            </div>
        }
        @if (_rangeWarning is not null)
        {
            <div style="background:#eaf1f8;border:1px solid #b9d0e6;color:#2d5f8a;border-radius:6px;padding:6px 10px;font-size:12.5px;margin-bottom:8px">@_rangeWarning</div>
        }

        {
            var totalMatched = _upcoming.Count + _past.Count;
            <div style="font-size:13px;color:#5a7183;margin-bottom:10px">
                @if (totalMatched == 0)
                {
                    <span>No results in @_lastResolvedStart.ToString("MMM d, yyyy") - @_lastResolvedEnd.ToString("MMM d, yyyy").</span>
                }
                else
                {
                    <span>@totalMatched result@(totalMatched == 1 ? "" : "s") - @_onIceMatchCount on the ice, @_offIceMatchCount off the ice - @_lastResolvedStart.ToString("MMM d, yyyy") to @_lastResolvedEnd.ToString("MMM d, yyyy")</span>
                }
            </div>

            @if (totalMatched > MaxRenderedRows)
            {
                <div style="background:#fdf8ec;border:1px solid #f0d58c;color:#8a6d1f;border-radius:6px;padding:6px 10px;font-size:12.5px;margin-bottom:10px">
                    Showing the first @MaxRenderedRows of @totalMatched - narrow your search to see the rest.
                </div>
            }

            @if (_cappedUpcoming.Count > 0)
            {
                <div style="font-size:13px;font-weight:600;color:#90a0ab;letter-spacing:.05em;margin-bottom:6px">UPCOMING</div>
                <div style="display:flex;flex-direction:column;gap:6px;margin-bottom:16px">
                    @foreach (var row in _cappedUpcoming)
                    {
                        @if (row.Booking is { } ub)
                        {
                            <div @onclick="() => OpenResult(row)"
                                 style="display:flex;align-items:center;gap:10px;border:1px solid #e7ecef;border-radius:6px;padding:9px 12px;cursor:pointer;background:#fff">
                                <span style="background:@CalendarStyles.CategoryColor(ub.Category);color:#fff;padding:2px 10px;border-radius:10px;font-weight:600;font-size:12px;white-space:nowrap">@CalendarStyles.CategoryLabel(ub.Category)</span>
                                <span style="font-weight:600;color:#1e2a33;font-size:14px">@CalendarStyles.BookingDisplayTitle(ub)</span>
                                <span style="font-size:13px;color:#5a7183">@FormatBookingRange(ub)</span>
                                <span style="margin-left:auto;display:flex;align-items:center;gap:8px;font-size:12px;color:#5a7183;white-space:nowrap">
                                    @string.Join(", ", CalendarStyles.SiblingGroup(_allBookings, ub).Select(m => CalendarStyles.SheetLabel(m.SheetMailbox)))
                                    @if (ub.State == BookingState.Hold)
                                    {
                                        <span style="border:1px dashed #2d5f8a;color:#2d5f8a;padding:1px 8px;border-radius:8px;font-weight:600">Hold</span>
                                    }
                                </span>
                            </div>
                        }
                        else if (row.ClubEvent is { } uce)
                        {
                            <div @onclick="() => OpenResult(row)"
                                 style="display:flex;align-items:center;gap:10px;border:1.5px dotted #c1ccd4;border-radius:6px;padding:9px 12px;cursor:pointer;background:#fff">
                                <span style="background:@CalendarStyles.ClubEventCategoryColor(uce.Category);color:#fff;padding:2px 10px;border-radius:10px;font-weight:600;font-size:12px;white-space:nowrap">@CalendarStyles.ClubEventCategoryLabel(uce.Category)</span>
                                <span style="font-weight:600;color:#1e2a33;font-size:14px">@uce.Title</span>
                                <span style="font-size:13px;color:#5a7183">@FormatClubEventRange(uce)</span>
                                <span style="margin-left:auto;display:flex;align-items:center;gap:8px;font-size:12px;color:#5a7183;white-space:nowrap">
                                    Off-ice
                                    @if (uce.MarksSheetsUnavailable)
                                    {
                                        <span style="color:#a02c21;font-weight:600">All sheets closed</span>
                                    }
                                </span>
                            </div>
                        }
                    }
                </div>
            }

            @if (_cappedPast.Count > 0)
            {
                <div style="font-size:13px;font-weight:600;color:#90a0ab;letter-spacing:.05em;margin-bottom:6px">PAST</div>
                <div style="display:flex;flex-direction:column;gap:6px">
                    @foreach (var row in _cappedPast)
                    {
                        @if (row.Booking is { } pb)
                        {
                            <div @onclick="() => OpenResult(row)"
                                 style="display:flex;align-items:center;gap:10px;border:1px solid #e7ecef;border-radius:6px;padding:9px 12px;cursor:pointer;background:#fafbfc">
                                <span style="background:@CalendarStyles.CategoryColor(pb.Category);color:#fff;padding:2px 10px;border-radius:10px;font-weight:600;font-size:12px;white-space:nowrap">@CalendarStyles.CategoryLabel(pb.Category)</span>
                                <span style="font-weight:600;color:#1e2a33;font-size:14px">@CalendarStyles.BookingDisplayTitle(pb)</span>
                                <span style="font-size:13px;color:#5a7183">@FormatBookingRange(pb)</span>
                                <span style="margin-left:auto;display:flex;align-items:center;gap:8px;font-size:12px;color:#5a7183;white-space:nowrap">
                                    @string.Join(", ", CalendarStyles.SiblingGroup(_allBookings, pb).Select(m => CalendarStyles.SheetLabel(m.SheetMailbox)))
                                    @if (pb.State == BookingState.Hold)
                                    {
                                        <span style="border:1px dashed #2d5f8a;color:#2d5f8a;padding:1px 8px;border-radius:8px;font-weight:600">Hold</span>
                                    }
                                </span>
                            </div>
                        }
                        else if (row.ClubEvent is { } pce)
                        {
                            <div @onclick="() => OpenResult(row)"
                                 style="display:flex;align-items:center;gap:10px;border:1.5px dotted #c1ccd4;border-radius:6px;padding:9px 12px;cursor:pointer;background:#fafbfc">
                                <span style="background:@CalendarStyles.ClubEventCategoryColor(pce.Category);color:#fff;padding:2px 10px;border-radius:10px;font-weight:600;font-size:12px;white-space:nowrap">@CalendarStyles.ClubEventCategoryLabel(pce.Category)</span>
                                <span style="font-weight:600;color:#1e2a33;font-size:14px">@pce.Title</span>
                                <span style="font-size:13px;color:#5a7183">@FormatClubEventRange(pce)</span>
                                <span style="margin-left:auto;display:flex;align-items:center;gap:8px;font-size:12px;color:#5a7183;white-space:nowrap">
                                    Off-ice
                                    @if (pce.MarksSheetsUnavailable)
                                    {
                                        <span style="color:#a02c21;font-weight:600">All sheets closed</span>
                                    }
                                </span>
                            </div>
                        }
                    }
                </div>
            }
        }
    }
</div>

<BookingDetailModal Group="_detailGroup" ReadOnly="true" OnClose="() => _detailGroup = null" OnOpenOnCalendar="OpenOnCalendar" />
<ClubEventDetailModal ClubEvent="_clubEventDetail" ReadOnly="true" OnClose="() => _clubEventDetail = null" OnOpenOnCalendar="OpenClubEventOnCalendar" />

@code {
    private const int MaxRenderedRows = 300;

    internal enum SearchViewState { Idle, Searching, Results }

    /// <summary>
    /// Which of the three top-level views the page shows - extracted as a pure function (D75) after
    /// a real live-found bug: the markup used to nest the "Searching…" check inside a branch gated
    /// on <c>hasSearched</c>, but <c>hasSearched</c> only flips to true at the very end of a search
    /// (after the fetch and ApplyResults complete) - so the spinner was unreachable on the very
    /// first search of a page load, or any search after the query was cleared, which is exactly
    /// when the wait is longest and the feedback matters most. It only ever showed on a later
    /// search in the same session, once <c>hasSearched</c> was already true from a prior one.
    /// <c>isSearching</c> is checked first and wins regardless of <c>hasSearched</c>, fixing that.
    /// </summary>
    internal static SearchViewState ResolveViewState(bool isSearching, bool hasSearched) =>
        isSearching ? SearchViewState.Searching :
        !hasSearched ? SearchViewState.Idle :
        SearchViewState.Results;

    private string _query = string.Empty;
    private DateTime? _rangeStart;
    private DateTime? _rangeEnd;
    private bool _searchEntireSeason;

    /// <summary>Set by the query box's own handlers to mark a render that only exists because a
    /// character was typed; see <see cref="ShouldRender"/>.</summary>
    private bool _typingOnly;

    private bool _hasSearched;
    private bool _isSearching;
    private (DateTime Start, DateTime End)? _fetchedRange;
    private List<SheetBooking> _allBookings = [];
    private List<ClubEvent> _allClubEvents = [];

    private IReadOnlyList<SearchNotice> _notices = [];
    private string? _rangeWarning;
    private DateTime _lastResolvedStart;
    private DateTime _lastResolvedEnd;
    private int _onIceMatchCount;
    private int _offIceMatchCount;
    private List<ResultRow> _cappedUpcoming = [];
    private List<ResultRow> _cappedPast = [];
    private List<ResultRow> _upcoming = [];
    private List<ResultRow> _past = [];

    private List<SheetBooking>? _detailGroup;
    private ClubEvent? _clubEventDetail;

    // No fetch here - only sets the date pickers' defaults and renders the help card. A page that
    // fanned out across every sheet for a wide range on plain navigation would charge that cost to
    // every stray menu click.
    protected override void OnInitialized()
    {
        var today = Facility.Today;
        _rangeStart = today.AddDays(-SearchRange.DefaultLookbackDays);
        _rangeEnd = today.AddDays(SearchRange.DefaultLookaheadDays);
    }

    // This used to be `_ = RunSearch();` (fire-and-forget) from a synchronous void handler - the
    // actual root cause of results never appearing on the Enter-key path. Blazor Server's automatic
    // "await the handler, then re-render" only applies to the Task it's actually given; a detached
    // task is invisible to it. RunSearch's own leading StateHasChanged() (before its first await)
    // still reaches the renderer, since nothing has escaped the circuit's SynchronizationContext
    // yet at that point - which is exactly why the "Searching..." spinner, once reachable at all
    // (see ResolveViewState), still showed up correctly. But there was no explicit StateHasChanged()
    // after the fetch completed, so the final results render was never triggered on this path at
    // all - not delayed, genuinely never sent. The Search button's @onclick="RunSearch" binds
    // directly to the async method, which Blazor DOES await properly, which is why that path always
    // worked. Awaiting here instead of discarding makes the two paths identical.
    //
    // Returns RunSearch's own Task rather than awaiting it, and Task.CompletedTask synchronously for
    // every other key. An `async Task` handler yields even when it does nothing, and Blazor renders
    // both at that yield and again on completion - so every non-Enter keystroke cost two renders of
    // this page instead of none. Returning an already-completed Task keeps the Enter path identical
    // (Blazor still awaits what it's handed) while costing one render instead of two everywhere else.
    private Task OnQueryKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            return RunSearch();
        }

        _typingOnly = true;
        return Task.CompletedTask;
    }

    private void OnQueryInput(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? string.Empty;
        _typingOnly = true;
    }

    /// <summary>
    /// Typing in the query box changes nothing this page displays - <see cref="_query"/> is read only
    /// by <see cref="RunSearch"/>, and the browser already holds the text - but each keystroke fires
    /// both onkeydown and oninput, and each of those re-rendered the entire results list. With the
    /// render cap at <see cref="MaxRenderedRows"/> that was up to 600 row renders per character typed,
    /// on top of the two SignalR round trips the model already costs. Live-reported 2026-08-27 as
    /// typing lag by a staff member on a high-latency connection.
    ///
    /// Only the two typing handlers set the flag, so every other interaction - running a search,
    /// changing a date, opening a result - renders normally.
    /// </summary>
    protected override bool ShouldRender()
    {
        if (!_typingOnly)
        {
            return true;
        }

        _typingOnly = false;
        return false;
    }

    private void OnRangeStartChanged(ChangeEventArgs e)
    {
        _rangeStart = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : null;
    }

    private void OnRangeEndChanged(ChangeEventArgs e)
    {
        _rangeEnd = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : null;
    }

    // Reactive to the currently-picked dates, evaluated on every render - so a too-wide or
    // backwards range is visible and blocks Search the moment it's picked, not after a search is
    // attempted and silently clamped. Null start/end (unset) is never blocking - SearchRange.Resolve
    // falls back to its own defaults for either.
    private int? RequestedSpanDays => _rangeStart.HasValue && _rangeEnd.HasValue
        ? (_rangeEnd.Value.Date - _rangeStart.Value.Date).Days
        : null;

    private bool RangeEndBeforeStart => _rangeStart.HasValue && _rangeEnd.HasValue && _rangeEnd.Value.Date < _rangeStart.Value.Date;
    private bool RangeTooWide => RequestedSpanDays is { } days && days > SearchRange.MaxSpanDays;
    private bool RangeBlocksSearch => RangeEndBeforeStart || RangeTooWide;

    // "Search entire season" (D111) reads Window.SeasonStartDate/SeasonEndDate instead of _rangeStart/
    // _rangeEnd, so it needs both configured to mean anything - unlike the Settings page's own
    // Booking Season toggle, where either half being blank is a legitimate "unrestricted on that
    // side" state (§4.10), a search needs a real closed window to run against.
    private bool SeasonNotConfigured => Window.SeasonStartDate is null || Window.SeasonEndDate is null;

    // Reactive to which mode is active, evaluated on every render - same "visible and blocking before
    // Search is even attempted" property RangeBlocksSearch already had, extended to cover the season
    // checkbox's own precondition instead of just the typed-range one.
    private bool SearchBlocked => _searchEntireSeason ? SeasonNotConfigured : RangeBlocksSearch;

    private string? BlockMessage =>
        _searchEntireSeason
            ? (SeasonNotConfigured ? "No booking season is configured - set one on the Settings page to use this." : null)
            : RangeBlockMessage;

    // Built from the last RESOLVED search (_query/_lastResolvedStart/_lastResolvedEnd/_searchEntireSeason),
    // not the live text/checkbox state - so the link always points at exactly the results currently on
    // screen, not whatever's been changed since without yet pressing Search/Enter. season=1 (rather
    // than encoding _lastResolvedStart/_lastResolvedEnd directly) tells the export endpoint to
    // re-resolve the season live itself (StaffSearchExportEndpoint's own doc comment explains why:
    // the season could have changed between this search and the export click).
    private string ExportUrl => _searchEntireSeason
        ? $"/search/export.csv?q={Uri.EscapeDataString(_query)}&season=1"
        : $"/search/export.csv?q={Uri.EscapeDataString(_query)}&start={_lastResolvedStart:yyyy-MM-dd}&end={_lastResolvedEnd:yyyy-MM-dd}";

    private string? RangeBlockMessage =>
        RangeEndBeforeStart ? "End date is before start date - fix the dates to search." :
        RangeTooWide ? $"That's a {RequestedSpanDays}-day range - narrow it to {SearchRange.MaxSpanDays} days or fewer to search." :
        null;

    // Runs on Enter or the Search button only - never search-as-you-type, since each keystroke could
    // otherwise trigger a Graph fan-out if the range happened to change too.
    private async Task RunSearch()
    {
        if (_isSearching || SearchBlocked)
        {
            return;
        }

        var query = SearchQueryParser.Parse(_query);
        _notices = query.Notices;

        if (query.IsEmpty)
        {
            _hasSearched = false;
            _rangeWarning = null;
            return;
        }

        // SeasonNotConfigured already guarded this above (SearchBlocked), so Window.SeasonStartDate/
        // SeasonEndDate are non-null whenever _searchEntireSeason reaches here.
        var (start, end, warning) = _searchEntireSeason
            ? SearchRange.ResolveSeason(Window.SeasonStartDate!.Value, Window.SeasonEndDate!.Value, Facility.Today)
            : SearchRange.Resolve(_rangeStart, _rangeEnd, Facility.Today);
        _rangeWarning = warning;
        _lastResolvedStart = start;
        _lastResolvedEnd = end;

        // Refining the query text against an unchanged range costs zero Graph calls - only a range
        // change re-fetches. Holding the snapshot in page state (not the service's own 30s cache) is
        // what makes iterating on the search text cheap.
        if (_fetchedRange is null || _fetchedRange.Value.Start != start || _fetchedRange.Value.End != end)
        {
            _isSearching = true;
            StateHasChanged();

            try
            {
                var fetchEnd = end.AddDays(1); // end is the last INCLUDED day; services take an exclusive upper bound.
                _allBookings = await BookingService.GetBookingsForAllSheetsAsync(start, fetchEnd);
                _allClubEvents = await ClubEventService.GetEventsAsync(start, fetchEnd);
                _fetchedRange = (start, end);
            }
            finally
            {
                _isSearching = false;
            }
        }

        ApplyResults(query);
        _hasSearched = true;
    }

    private void ApplyResults(SearchQuery query)
    {
        var result = SearchResultsBuilder.Build(_allBookings, _allClubEvents, query, Facility.Today);
        _onIceMatchCount = result.OnIceMatchCount;
        _offIceMatchCount = result.OffIceMatchCount;
        _upcoming = result.Upcoming;
        _past = result.Past;

        // Upcoming first when the combined set exceeds the render cap - a stale past occurrence is
        // less actionable than a future one when both can't fit. The cap is a render-cost concern
        // for THIS page only - SearchResultsBuilder itself never truncates, which is what lets the
        // CSV export (StaffSearchExportEndpoint) return every match with nothing silently dropped.
        _cappedUpcoming = _upcoming.Take(MaxRenderedRows).ToList();
        var remaining = MaxRenderedRows - _cappedUpcoming.Count;
        _cappedPast = remaining > 0 ? _past.Take(remaining).ToList() : [];
    }

    private void OpenResult(ResultRow row)
    {
        if (row.Booking is { } b)
        {
            _detailGroup = CalendarStyles.SiblingGroup(_allBookings, b);
        }
        else if (row.ClubEvent is { } ce)
        {
            _clubEventDetail = ce;
        }
    }

    private void OpenOnCalendar(List<SheetBooking> group) =>
        Navigation.NavigateTo($"/calendar?view=day&date={group[0].Start:yyyy-MM-dd}");

    private void OpenClubEventOnCalendar(ClubEvent ce) =>
        Navigation.NavigateTo($"/calendar?view=day&date={ce.Start:yyyy-MM-dd}");

    private static string FormatBookingRange(SheetBooking b) =>
        b.Start.Date == b.End.Date
            ? $"{b.Start:dddd, MMM d, yyyy} · {b.Start:h:mmtt}-{b.End:h:mmtt}"
            : $"{b.Start:MMM d, h:mmtt} - {b.End:MMM d, h:mmtt yyyy}";

    private static string FormatClubEventRange(ClubEvent ce)
    {
        if (ce.IsAllDay)
        {
            return ce.Start.Date == ce.End.Date
                ? ce.Start.ToString("dddd, MMM d, yyyy")
                : $"{ce.Start:MMM d} - {ce.End:MMM d, yyyy}";
        }

        return ce.Start.Date == ce.End.Date
            ? $"{ce.Start:dddd, MMM d, yyyy} · {ce.Start:h:mmtt}-{ce.End:h:mmtt}"
            : $"{ce.Start:MMM d, h:mmtt} - {ce.End:MMM d, h:mmtt yyyy}";
    }
}
