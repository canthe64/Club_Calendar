@page "/settings"
@using FacilityScheduler.Domain
@using FacilityScheduler.Services
@inject AppLogService LogService
@inject SheetBookingService BookingService
@inject AuthenticationStateProvider AuthProvider
@inject SchedulingWindowService Window

<PageTitle>Settings</PageTitle>

<div style="padding:16px 24px;max-width:900px">
    <h1>Settings</h1>

    <div style="color:#5a7183;font-size:15px;margin:-6px 0 22px">
        <span style="font-weight:600;color:#1e2a33">@AppVersion.Display</span>
        @if (AppVersion.BuiltUtc is DateTime built)
        {
            <span style="margin-left:10px">built @built.ToString("yyyy-MM-dd HH:mm") UTC</span>
        }
    </div>

    <section style="margin-bottom:28px;padding-bottom:20px;border-bottom:1px solid #e7ecef">
        <h2 style="font-size:18px;margin-bottom:8px">Practice Ice Requests</h2>
        <p style="color:#5a7183;font-size:15px;margin-bottom:10px;max-width:640px">
            Review and approve or decline member requests to host practice ice.
        </p>
        <a href="/practice-ice/approvals" class="btn btn-secondary">View requests</a>
    </section>

    <section style="margin-bottom:28px;padding-bottom:20px;border-bottom:1px solid #e7ecef">
        <h2 style="font-size:18px;margin-bottom:8px">Logging Level</h2>
        <p style="color:#5a7183;font-size:15px;margin-bottom:10px;max-width:640px">
            <strong>Standard</strong> (the default) logs definitive actions only - bookings, series,
            and off-ice events created, edited, or canceled, with who did it. <strong>Debug</strong> adds
            staff sign-in events and full detail on every Breely webhook call, including the raw data
            Breely sends - useful while actively troubleshooting, but noisier.
        </p>
        <label style="margin-right:16px;cursor:pointer">
            <input type="radio" name="level" checked="@(_level == AppLogLevel.Standard)" @onchange="() => _level = AppLogLevel.Standard" /> Standard
        </label>
        <label style="cursor:pointer">
            <input type="radio" name="level" checked="@(_level == AppLogLevel.Debug)" @onchange="() => _level = AppLogLevel.Debug" /> Debug
        </label>
        <button class="btn btn-primary" style="margin-left:16px" @onclick="SaveLevel" disabled="@_saving">Save</button>
        @if (_savedMessage is not null)
        {
            <span style="margin-left:10px;color:#2d7a3f;font-size:15px">@_savedMessage</span>
        }
        @if (_level == AppLogLevel.Debug)
        {
            <div style="margin-top:10px;padding:8px 12px;border:1px solid #e8b4ae;background:#fdf3f1;border-radius:6px;color:#a02c21;font-size:14px;max-width:640px">
                <strong>Debug mode may log customer names, emails, and phone numbers</strong> from
                Breely bookings. Turn it back to <strong>Standard</strong> once you're done
                troubleshooting - don't leave it on.
            </div>
        }
    </section>

    <section style="margin-bottom:28px;padding-bottom:20px;border-bottom:1px solid #e7ecef">
        <h2 style="font-size:18px;margin-bottom:8px">Minimum group event booking interval</h2>
        <p style="color:#5a7183;font-size:15px;margin-bottom:10px;max-width:640px">
            When a Breely booking claims part of an open Group Event hold, whatever time is left
            over before and/or after it is offered as its own bookable slot - unless it's shorter
            than this many minutes, in which case that leftover time is dropped instead of offered.
        </p>
        <select @bind="_minimumIntervalMinutes">
            @foreach (var minutes in MinimumIntervalChoices)
            {
                <option value="@minutes">@minutes minutes</option>
            }
        </select>
        <button class="btn btn-primary" style="margin-left:16px" @onclick="SaveMinimumInterval" disabled="@_savingInterval">Save</button>
        @if (_intervalSavedMessage is not null)
        {
            <span style="margin-left:10px;color:#2d7a3f;font-size:15px">@_intervalSavedMessage</span>
        }
    </section>

    <section style="margin-bottom:28px;padding-bottom:20px;border-bottom:1px solid #e7ecef">
        <h2 style="font-size:18px;margin-bottom:8px">Public Calendar Visibility</h2>
        <p style="color:#5a7183;font-size:15px;margin-bottom:10px;max-width:640px">
            Hides anything starting after this date from the public calendar and the club-website
            widget only - staff still see and edit everything on the staff calendar regardless.
            Leave blank to show everything publicly, same as today.
        </p>
        <div style="font-size:15px;color:#1e2a33;font-weight:600;margin-bottom:8px">
            @(Window.PublicCutoffDate is { } cutoff ? $"Currently hiding anything after {cutoff:MMM d, yyyy}." : "Currently showing everything.")
        </div>
        <input type="date" value="@(_cutoffDraft?.ToString("yyyy-MM-dd"))" @onchange="OnCutoffDateChanged"
               style="border:1px solid #d7dfe5;border-radius:6px;padding:6px 9px;font-size:15px">
        <button class="btn btn-primary" style="margin-left:16px" @onclick="SaveCutoff" disabled="@_savingCutoff">Apply</button>
        <button class="btn btn-secondary" @onclick="ClearCutoff" disabled="@(_savingCutoff || _cutoffDraft is null)">Clear</button>
        @if (_cutoffSavedMessage is not null)
        {
            <span style="margin-left:10px;color:#2d7a3f;font-size:15px">@_cutoffSavedMessage</span>
        }
    </section>

    <section style="margin-bottom:28px;padding-bottom:20px;border-bottom:1px solid #e7ecef">
        <h2 style="font-size:18px;margin-bottom:8px">Booking Season</h2>
        <p style="color:#5a7183;font-size:15px;margin-bottom:10px;max-width:640px">
            Rejects new sheet bookings (staff bookings, series, and practice ice requests) outside
            this window, and stops advertising off-season slots on the public search tool, the
            widget, and practice ice. <strong>Off-ice events are exempt</strong> - closures, off-season
            meetings, and next season's planning still go on the calendar regardless. Leave either
            date blank to leave that side unrestricted.
        </p>
        <div style="font-size:15px;color:#1e2a33;font-weight:600;margin-bottom:8px">
            @SeasonSummary
        </div>
        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
            <div>
                <div style="font-size:12px;color:#90a0ab;margin-bottom:2px">Season start</div>
                <input type="date" value="@(_seasonStartDraft?.ToString("yyyy-MM-dd"))" @onchange="OnSeasonStartChanged"
                       style="border:1px solid #d7dfe5;border-radius:6px;padding:6px 9px;font-size:15px">
            </div>
            <div>
                <div style="font-size:12px;color:#90a0ab;margin-bottom:2px">Season end</div>
                <input type="date" value="@(_seasonEndDraft?.ToString("yyyy-MM-dd"))" @onchange="OnSeasonEndChanged"
                       style="border:1px solid #d7dfe5;border-radius:6px;padding:6px 9px;font-size:15px">
            </div>
            <button class="btn btn-primary" @onclick="SaveSeasonWindow" disabled="@(_savingSeason || !SeasonIsValid)">Save</button>
            <button class="btn btn-secondary" @onclick="ClearSeasonWindow" disabled="@(_savingSeason || (_seasonStartDraft is null && _seasonEndDraft is null))">Clear</button>
        </div>
        @if (!SeasonIsValid)
        {
            <div style="font-size:13px;color:#a02c21;margin-top:6px">The season end must be on or after the season start.</div>
        }
        @if (_seasonSavedMessage is not null)
        {
            <span style="color:#2d7a3f;font-size:15px">@_seasonSavedMessage</span>
        }
    </section>

    <section>
        <h2 style="font-size:18px;margin-bottom:8px">Recent Activity</h2>
        <p style="color:#5a7183;font-size:15px;margin-bottom:8px">Most recent 500 log lines.</p>
        <div style="margin-bottom:8px">
            <button class="btn btn-secondary" @onclick="RefreshTail">Refresh</button>
            <a href="/settings/logs/download" style="margin-left:12px;font-size:15px;color:#2d5f8a" target="_blank">Download full log archive (.zip)</a>
        </div>
        <pre style="background:#0f1720;color:#d7e2ea;border-radius:8px;padding:12px;max-height:520px;overflow:auto;font-size:14px;line-height:1.5;white-space:pre-wrap;word-break:break-all">@string.Join("\n", _tail)</pre>
    </section>
</div>

@code {
    private AppLogLevel _level;
    private List<string> _tail = [];
    private bool _saving;
    private string? _savedMessage;

    private static readonly int[] MinimumIntervalChoices = [30, 60, 90, 120];
    private int _minimumIntervalMinutes;
    private bool _savingInterval;
    private string? _intervalSavedMessage;

    private DateTime? _cutoffDraft;
    private bool _savingCutoff;
    private string? _cutoffSavedMessage;

    private DateTime? _seasonStartDraft;
    private DateTime? _seasonEndDraft;
    private bool _savingSeason;
    private string? _seasonSavedMessage;

    private bool SeasonIsValid => _seasonStartDraft is null || _seasonEndDraft is null || _seasonEndDraft >= _seasonStartDraft;

    private string SeasonSummary => (Window.SeasonStartDate, Window.SeasonEndDate) switch
    {
        ({ } s, { } e) => $"Currently {s:MMM d, yyyy} – {e:MMM d, yyyy}.",
        ({ } s, null) => $"Currently starts {s:MMM d, yyyy}, no end date set.",
        (null, { } e) => $"Currently ends {e:MMM d, yyyy}, no start date set.",
        _ => "Currently unrestricted - bookings allowed any time.",
    };

    protected override async Task OnInitializedAsync()
    {
        _level = LogService.CurrentLevel;

        // Snap to the nearest of the four fixed choices - a value persisted before this was a
        // dropdown (or edited directly on disk) might not be exactly one of them.
        var current = BookingService.MinimumGroupEventBookingIntervalMinutes;
        _minimumIntervalMinutes = MinimumIntervalChoices.Contains(current)
            ? current
            : MinimumIntervalChoices.OrderBy(m => Math.Abs(m - current)).First();

        _cutoffDraft = Window.PublicCutoffDate;
        _seasonStartDraft = Window.SeasonStartDate;
        _seasonEndDraft = Window.SeasonEndDate;

        await RefreshTail();
    }

    private void OnCutoffDateChanged(ChangeEventArgs e) =>
        _cutoffDraft = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : null;

    private void OnSeasonStartChanged(ChangeEventArgs e) =>
        _seasonStartDraft = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : null;

    private void OnSeasonEndChanged(ChangeEventArgs e) =>
        _seasonEndDraft = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : null;

    private async Task SaveCutoff()
    {
        _savingCutoff = true;
        _cutoffSavedMessage = null;
        try
        {
            var actor = await GetCurrentUserNameAsync();
            await Window.SetPublicCutoffAsync(_cutoffDraft, actor);
            _cutoffSavedMessage = "Saved.";
        }
        finally
        {
            _savingCutoff = false;
        }
    }

    private async Task ClearCutoff()
    {
        _cutoffDraft = null;
        await SaveCutoff();
    }

    private async Task SaveSeasonWindow()
    {
        if (!SeasonIsValid)
        {
            return;
        }

        _savingSeason = true;
        _seasonSavedMessage = null;
        try
        {
            var actor = await GetCurrentUserNameAsync();
            await Window.SetSeasonWindowAsync(_seasonStartDraft, _seasonEndDraft, actor);
            _seasonSavedMessage = "Saved.";
        }
        finally
        {
            _savingSeason = false;
        }
    }

    private async Task ClearSeasonWindow()
    {
        _seasonStartDraft = null;
        _seasonEndDraft = null;
        await SaveSeasonWindow();
    }

    private async Task SaveMinimumInterval()
    {
        _savingInterval = true;
        _intervalSavedMessage = null;
        try
        {
            var actor = await GetCurrentUserNameAsync();
            await BookingService.SetMinimumGroupEventBookingIntervalAsync(_minimumIntervalMinutes, actor);
            _intervalSavedMessage = "Saved.";
        }
        finally
        {
            _savingInterval = false;
        }
    }

    private async Task RefreshTail()
    {
        var lines = await LogService.TailAsync(500);
        _tail = lines.Count > 0 ? lines : ["(no log entries yet)"];
    }

    private async Task SaveLevel()
    {
        _saving = true;
        _savedMessage = null;
        try
        {
            var actor = await GetCurrentUserNameAsync();
            await LogService.SetLevelAsync(_level, actor);
            _savedMessage = "Saved.";
            await RefreshTail();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task<string> GetCurrentUserNameAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        return authState.User.Identity?.Name ?? "Unknown";
    }
}
