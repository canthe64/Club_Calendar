@page "/club-events"
@using FacilityScheduler.Domain
@using FacilityScheduler.Services
@using FacilityScheduler.Components.Calendar
@inject ClubEventService EventService
@inject AuthenticationStateProvider AuthProvider
@inject FacilityConfiguration Facility

<PageTitle>Off-Ice Events</PageTitle>

<div style="padding:16px 24px">
    <div style="display:flex;align-items:center;gap:14px;margin-bottom:14px">
        <span style="font-size:18px;font-weight:600;color:#1e2a33">Off-Ice Events</span>
        <span style="font-size:15px;color:#90a0ab">Everything that isn't on the ice - bonspiels away, meetings, closures, social events.</span>
        <span @onclick="OpenCreateForm" style="margin-left:auto;background:#c62f2f;color:#fff;padding:8px 15px;border-radius:6px;font-weight:600;font-size:15.5px;cursor:pointer">+ New Event</span>
    </div>

    @if (_loading)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <div style="font-size:13px;font-weight:600;color:#90a0ab;letter-spacing:.05em;margin-bottom:6px">UPCOMING</div>
        @if (_upcoming.Count == 0)
        {
            <div style="color:#c1ccd4;font-size:13px;margin-bottom:16px">No upcoming off-ice events.</div>
        }
        else
        {
            <div style="display:flex;flex-direction:column;gap:6px;margin-bottom:16px">
                @foreach (var e in _upcoming)
                {
                    <div @onclick="() => StartEdit(e)"
                         style="display:flex;align-items:center;gap:10px;border:1px solid #e7ecef;border-radius:6px;padding:9px 12px;cursor:pointer;background:#fff">
                        <span style="background:@CalendarStyles.ClubEventCategoryColor(e.Category);color:#fff;padding:2px 10px;border-radius:10px;font-weight:600;font-size:12px;white-space:nowrap">@CalendarStyles.ClubEventCategoryLabel(e.Category)</span>
                        <span style="font-weight:600;color:#1e2a33;font-size:14px">@e.Title</span>
                        <span style="font-size:13px;color:#5a7183">@FormatRange(e)</span>
                        @if (e.MarksSheetsUnavailable)
                        {
                            <span style="margin-left:auto;font-size:12px;color:#a02c21;font-weight:600">All sheets unavailable</span>
                        }
                    </div>
                }
            </div>
        }

        <div style="font-size:13px;font-weight:600;color:#90a0ab;letter-spacing:.05em;margin-bottom:6px">PAST</div>
        @if (_past.Count == 0)
        {
            <div style="color:#c1ccd4;font-size:13px">No past off-ice events in the last 30 days.</div>
        }
        else
        {
            <div style="display:flex;flex-direction:column;gap:6px">
                @foreach (var e in _past)
                {
                    <div @onclick="() => StartEdit(e)"
                         style="display:flex;align-items:center;gap:10px;border:1px solid #e7ecef;border-radius:6px;padding:9px 12px;cursor:pointer;background:#fafbfc">
                        <span style="background:@CalendarStyles.ClubEventCategoryColor(e.Category);color:#fff;padding:2px 10px;border-radius:10px;font-weight:600;font-size:12px;white-space:nowrap">@CalendarStyles.ClubEventCategoryLabel(e.Category)</span>
                        <span style="font-weight:600;color:#1e2a33;font-size:14px">@e.Title</span>
                        <span style="font-size:13px;color:#5a7183">@FormatRange(e)</span>
                        @if (e.MarksSheetsUnavailable)
                        {
                            <span style="margin-left:auto;font-size:12px;color:#a02c21;font-weight:600">All sheets unavailable</span>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

<EventFormModal IsOpen="_formOpen" Draft="_draft" AllowModeToggle="false" IsSaving="_isSaving" OnSave="SaveDraft" OnCancel="CloseForm" OnDelete="DeleteDraft" />

@code {
    private bool _loading = true;
    private List<ClubEvent> _upcoming = [];
    private List<ClubEvent> _past = [];

    private bool _formOpen;
    private EventDraft _draft = new();
    private bool _isSaving;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        var today = Facility.Today;
        var start = today.AddDays(-30);
        var end = today.AddDays(366);
        var events = await EventService.GetEventsAsync(start, end);
        _upcoming = events.Where(e => e.End.Date >= today).OrderBy(e => e.Start).ToList();
        _past = events.Where(e => e.End.Date < today).OrderByDescending(e => e.Start).ToList();

        _loading = false;
    }

    // Anchored on today, unlike the calendar page's own create path - this page has no "currently in
    // view" date to anchor to. The dialog opens locked to off-ice: this page only manages off-ice
    // events, so offering the toggle here would let a save land somewhere the list can't show.
    private void OpenCreateForm()
    {
        _draft = new EventDraft();
        _draft.ResetForCreate(EventMode.OffIce, Facility.Today);
        _formOpen = true;
    }

    private void StartEdit(ClubEvent e)
    {
        _draft = new EventDraft();
        _draft.LoadForEdit(e);
        _formOpen = true;
    }

    private void CloseForm()
    {
        _formOpen = false;
    }

    private async Task SaveDraft()
    {
        if (_isSaving || !EventDraft.Validate(_draft).CanSave)
        {
            return;
        }

        _isSaving = true;
        StateHasChanged();

        try
        {
            var bookedBy = await GetCurrentUserNameAsync();
            var clubEvent = _draft.OffIce.ToClubEvent(bookedBy);

            if (_draft.OffIce.EditingEvent is null)
            {
                await EventService.CreateAsync(clubEvent, bookedBy);
            }
            else
            {
                await EventService.UpdateAsync(clubEvent, bookedBy);
            }

            CloseForm();
            await LoadAsync();
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeleteDraft()
    {
        if (_draft.OffIce.EditingEvent?.EventId is null)
        {
            return;
        }

        var actingUser = await GetCurrentUserNameAsync();
        await EventService.CancelAsync(_draft.OffIce.EditingEvent.EventId, actingUser);
        CloseForm();
        await LoadAsync();
    }

    private async Task<string> GetCurrentUserNameAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        return authState.User.Identity?.Name ?? "Unknown";
    }

    private static string FormatRange(ClubEvent e)
    {
        if (e.IsAllDay)
        {
            return e.Start.Date == e.End.Date
                ? e.Start.ToString("ddd, MMM d, yyyy")
                : $"{e.Start:MMM d} - {e.End:MMM d, yyyy}";
        }

        return e.Start.Date == e.End.Date
            ? $"{e.Start:ddd, MMM d, yyyy} - {e.Start:h:mmtt}-{e.End:h:mmtt}"
            : $"{e.Start:MMM d, h:mmtt} - {e.End:MMM d, h:mmtt yyyy}";
    }
}
