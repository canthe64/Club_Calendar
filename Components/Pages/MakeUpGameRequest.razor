@page "/make-up-game/request"
@attribute [Authorize(Policy = StaffAuthorizationPolicies.AnyAuthenticatedUser)]
@using FacilityScheduler.Domain
@using FacilityScheduler.Services
@inject PublicAvailabilityService AvailabilityService
@inject MakeUpGameService MakeUpGames
@inject AuthenticationStateProvider AuthProvider

@* Like /practice-ice/request, open to any signed-in member, not just staff - the second deliberate
   carve-out from the Staff-only fallback policy. *@

<PageTitle>Schedule a Make-Up Game</PageTitle>

<div style="padding:16px 24px;max-width:640px">
    <h1 style="font-size:16px">Schedule a Make-Up Game</h1>

    @if (_start is null)
    {
        <div style="padding:12px 16px;border:1px solid #e8b4ae;background:#fdf3f1;border-radius:8px;color:#a02c21;font-size:13px">
            No valid start time was given. <a href="/public/make-up-game">Go back and pick a time</a>.
        </div>
    }
    else if (_option is null)
    {
        <div style="padding:12px 16px;border:1px solid #e8b4ae;background:#fdf3f1;border-radius:8px;color:#a02c21;font-size:13px">
            That time is no longer available. <a href="/public/make-up-game">Go back and pick another time</a>.
        </div>
    }
    else if (_result is { IsSuccess: true, Booked: { } booked })
    {
        <div style="padding:12px 16px;border:1px solid #b8ddc0;background:#f0fbf3;border-radius:8px;color:#2d7a3f;font-size:13px">
            Your make-up game is booked for @booked.Start.ToString("dddd, MMM d"), @booked.Start.ToString("h:mmtt")-@booked.End.ToString("h:mmtt")
            on @CalendarStyles.SheetLabel(booked.SheetMailbox).
            @if (_result.StaffNotified && _result.RequesterNotified)
            {
                <text>A confirmation email is on its way to you and the calendar team.</text>
            }
            else
            {
                <text>It's on the calendar, but a confirmation email couldn't be sent - please let the calendar team know directly.</text>
            }
        </div>
    }
    else
    {
        <div style="border:1px solid #e7ecef;border-radius:8px;padding:12px 16px;margin-bottom:14px;font-size:13px">
            <div><strong>@_option.Start.ToString("dddd, MMMM d")</strong></div>
            <div>@_option.Start.ToString("h:mmtt") - @_option.End.ToString("h:mmtt")</div>
            <div>@CalendarStyles.SheetLabel(_option.SheetMailbox)</div>
        </div>

        <div style="color:#5a7183;font-size:13px;margin-bottom:14px">
            <p style="margin:0 0 8px">
                Please note the details of your scheduling request above. Your scheduling request will appear
                on the calendar immediately after submitting and you will receive a confirmation email.
            </p>
            <p style="margin:0 0 8px">Please acknowledge the following conditions by checking the box below:</p>
            <ol style="margin:0;padding-left:20px">
                <li>Your reservation time and sheet shown is <strong>NOT</strong> guaranteed. Make up games are
                    always a lower priority to pre-existing scheduled events.</li>
                <li style="margin-top:4px">Existing events get first priority to sheet selection. The sheet shown on
                    the reservation is suggestive only; when you arrive please inquire with the scheduled event
                    coordinator which sheets are available for your game.</li>
                <li style="margin-top:4px">If the existing event's needs change and require additional sheets, you
                    must relinquish your sheet to the other event.</li>
            </ol>
        </div>

        <label style="display:block;font-size:12px;margin-bottom:14px;cursor:pointer">
            <input type="checkbox" @bind="_acknowledged" /> I acknowledge the conditions above.
        </label>

        @if (_result is { IsSuccess: false })
        {
            <div style="margin-bottom:14px;padding:8px 12px;border:1px solid #e8b4ae;background:#fdf3f1;border-radius:6px;color:#a02c21;font-size:12px">@_result.Message</div>
        }

        <button class="btn btn-primary" @onclick="SubmitAsync" disabled="@(_submitting || !_acknowledged)">Submit Request</button>
    }
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Start { get; set; }

    private DateTime? _start;
    private MakeUpGameOption? _option;
    private bool _acknowledged;
    private bool _submitting;
    private MakeUpGameSubmitResult? _result;

    protected override async Task OnInitializedAsync()
    {
        // Same facility-local "yyyy-MM-ddTHH:mm" format MakeUpGamePublicEndpoint writes its links in.
        if (!DateTime.TryParseExact(Start, "yyyy-MM-ddTHH:mm", System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out var parsed))
        {
            return;
        }

        _start = parsed;
        _option = await AvailabilityService.GetMakeUpGameOptionAsync(parsed);
    }

    private async Task SubmitAsync()
    {
        if (_start is null)
        {
            return;
        }

        _submitting = true;
        try
        {
            var (name, email) = await GetRequesterIdentityAsync();
            _result = await MakeUpGames.SubmitAsync(_start.Value, name, email, _acknowledged);
        }
        finally
        {
            _submitting = false;
        }
    }

    // From the signed-in token only, via the one rule booking and cancelling share
    // (ClaimsPrincipalExtensions.MemberIdentity).
    private async Task<(string Name, string Email)> GetRequesterIdentityAsync() =>
        (await AuthProvider.GetAuthenticationStateAsync()).User.MemberIdentity();
}
