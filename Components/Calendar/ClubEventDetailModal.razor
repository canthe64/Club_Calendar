@using FacilityScheduler.Domain

@if (ClubEvent is not null)
{
    var ce = ClubEvent;
    <div @onclick="() => OnClose.InvokeAsync()" style="position:fixed;inset:0;background:rgba(30,42,51,.45);display:flex;align-items:center;justify-content:center;z-index:50">
        <div @onclick:stopPropagation="true" style="background:#fff;border-radius:10px;box-shadow:0 12px 32px rgba(0,0,0,.35);padding:18px 20px;width:440px">
            <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:2px">
                <span style="font-size:17px;font-weight:600;color:#1e2a33">@ce.Title</span>
                <span style="background:@CalendarStyles.ClubEventCategoryLightBg(ce.Category);color:@CalendarStyles.ClubEventCategoryColor(ce.Category);font-size:12px;font-weight:600;padding:2px 9px;border-radius:10px;white-space:nowrap">@CalendarStyles.ClubEventCategoryLabel(ce.Category)</span>
            </div>
            <div style="font-size:13px;color:#5a7183;margin-bottom:12px">@DateRangeText(ce)</div>

            <div style="display:flex;justify-content:space-between;border-bottom:1px solid #eef1f3;padding:6px 0;font-size:13.5px">
                <span style="color:#5a7183">Closes all sheets</span><span style="color:#1e2a33">@(ce.MarksSheetsUnavailable ? "Yes" : "No")</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(ce.Notes))
            {
                <div style="display:flex;justify-content:space-between;border-bottom:1px solid #eef1f3;padding:6px 0;font-size:13.5px">
                    <span style="color:#5a7183">Notes</span><span style="color:#1e2a33">@ce.Notes</span>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(ce.BookedBy))
            {
                <div style="display:flex;justify-content:space-between;border-bottom:1px solid #eef1f3;padding:6px 0;font-size:13.5px">
                    <span style="color:#5a7183">Booked by</span><span style="color:#1e2a33">@ce.BookedBy</span>
                </div>
            }

            @if (_confirmingDelete)
            {
                <div style="background:#fdf1f0;border:1px solid #e8b4ae;border-radius:8px;padding:10px 12px;margin-top:12px;font-size:13px">
                    <div style="color:#a02c21;font-weight:600;margin-bottom:6px">Delete this event? This can't be undone.</div>
                    <div style="display:flex;gap:8px;font-weight:600">
                        <span @onclick="() => OnDelete.InvokeAsync(ce)" style="flex:1;text-align:center;border:1px solid #e8b4ae;color:#a02c21;border-radius:6px;padding:6px 0;cursor:pointer">Yes, delete</span>
                        <span @onclick="() => _confirmingDelete = false" style="flex:1;text-align:center;color:#90a0ab;cursor:pointer;padding:6px 0">Never mind</span>
                    </div>
                </div>
            }
            else
            {
                <div style="display:flex;gap:8px;margin-top:14px;font-size:13.5px;font-weight:600">
                    @if (ReadOnly)
                    {
                        @* Reached from the search page - see BookingDetailModal's own ReadOnly comment
                           (D88): send staff to the working edit flow rather than a second copy of it. *@
                        <span @onclick="() => OnOpenOnCalendar.InvokeAsync(ce)" style="flex:1;text-align:center;border:1px solid #d7dfe5;color:#2d5f8a;border-radius:6px;padding:7px 0;cursor:pointer">Open on calendar</span>
                        <span @onclick="() => OnClose.InvokeAsync()" style="text-align:center;border:1px solid #d7dfe5;color:#5a7183;border-radius:6px;padding:7px 14px;cursor:pointer">Close</span>
                    }
                    else
                    {
                        <span @onclick="() => OnEdit.InvokeAsync(ce)" style="flex:1;text-align:center;border:1px solid #d7dfe5;color:#2d5f8a;border-radius:6px;padding:7px 0;cursor:pointer">Edit event…</span>
                        <span @onclick="() => _confirmingDelete = true" style="flex:1;text-align:center;border:1px solid #e8b4ae;color:#a02c21;border-radius:6px;padding:7px 0;cursor:pointer">Delete Event</span>
                        <span @onclick="() => OnClose.InvokeAsync()" style="text-align:center;border:1px solid #d7dfe5;color:#5a7183;border-radius:6px;padding:7px 14px;cursor:pointer">Close</span>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public ClubEvent? ClubEvent { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<ClubEvent> OnEdit { get; set; }
    [Parameter] public EventCallback<ClubEvent> OnDelete { get; set; }

    // Additive - defaults to false, so every existing call site (the calendar page) is unchanged.
    // The search page is the only ReadOnly caller today.
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public EventCallback<ClubEvent> OnOpenOnCalendar { get; set; }

    private bool _confirmingDelete;
    private ClubEvent? _lastClubEvent;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(ClubEvent, _lastClubEvent))
        {
            _confirmingDelete = false;
            _lastClubEvent = ClubEvent;
        }
    }

    private static string DateRangeText(ClubEvent ce)
    {
        if (ce.IsAllDay)
        {
            return ce.Start.Date == ce.End.Date
                ? ce.Start.ToString("dddd, MMM d")
                : $"{ce.Start:MMM d} - {ce.End:MMM d, yyyy}";
        }

        return ce.Start.Date == ce.End.Date
            ? $"{ce.Start:dddd, MMM d} · {ce.Start:h:mmtt}-{ce.End:h:mmtt}"
            : $"{ce.Start:MMM d, h:mmtt} - {ce.End:MMM d, h:mmtt yyyy}";
    }
}
