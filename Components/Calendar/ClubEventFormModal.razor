@using FacilityScheduler.Domain

@if (IsOpen)
{
    <div style="position:fixed;inset:0;background:rgba(30,42,51,.45);display:flex;align-items:center;justify-content:center;z-index:50">
        <div style="background:#fff;border-radius:10px;box-shadow:0 12px 32px rgba(0,0,0,.35);padding:18px 20px;width:460px;max-height:88vh;overflow:auto">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
                <span style="font-size:17px;font-weight:600;color:#1e2a33">@(Draft.EditingEvent is null ? "New Club Event" : "Edit Club Event")</span>
                <span @onclick="() => OnCancel.InvokeAsync()" style="color:#90a0ab;font-size:16px;cursor:pointer;padding:2px 6px">&#10005;</span>
            </div>

            <div style="display:flex;flex-direction:column;gap:11px;font-size:13px;color:#5a7183">
                <div>
                    <div style="font-weight:600;color:#1e2a33;margin-bottom:3px">Category</div>
                    @* flex-wrap + nowrap on the chips: six categories, one of them "Out of Town
                       Bonspiels", no longer fit on one row. Without wrap the row overflows the modal
                       and clips the last chip; without nowrap the long label breaks across three
                       lines and makes one chip three times the height of its neighbours. *@
                    <div style="display:flex;gap:6px;flex-wrap:wrap">
                        @foreach (var cat in CalendarStyles.ClubEventCategories)
                        {
                            var isSelected = Draft.Category == cat;
                            <span @onclick="() => Draft.Category = cat"
                                  style="background:@(isSelected ? CalendarStyles.ClubEventCategoryColor(cat) : "#fff");color:@(isSelected ? "#fff" : CalendarStyles.ClubEventCategoryColor(cat));border:1px solid @CalendarStyles.ClubEventCategoryColor(cat);padding:4px 12px;border-radius:12px;font-weight:600;cursor:pointer;white-space:nowrap">
                                @CalendarStyles.ClubEventCategoryLabel(cat)
                            </span>
                        }
                    </div>
                </div>

                <div><div style="font-weight:600;color:#1e2a33;margin-bottom:3px">Event Title</div>
                    <input value="@Draft.Title" @oninput="e => Draft.Title = e.Value?.ToString()" style="border:1px solid #d7dfe5;border-radius:6px;padding:6px 9px;font-size:13px;width:100%;box-sizing:border-box"></div>

                <div><span @onclick="() => Draft.IsAllDay = !Draft.IsAllDay" style="cursor:pointer;font-weight:600;color:#1e2a33">
                    <input type="checkbox" checked="@Draft.IsAllDay" style="pointer-events:none" /> All day
                </span></div>

                <div style="display:flex;gap:8px;align-items:end">
                    <div style="flex:1">
                        <div style="font-weight:600;color:#1e2a33;margin-bottom:3px">Start date</div>
                        <input type="date" value="@Draft.StartDate.ToString("yyyy-MM-dd")" @onchange="OnStartDateChanged"
                               style="border:1px solid #d7dfe5;border-radius:6px;padding:6px 9px;font-size:13px;width:100%;box-sizing:border-box">
                    </div>
                    <div style="flex:1">
                        <div style="font-weight:600;color:#1e2a33;margin-bottom:3px">End date</div>
                        <input type="date" value="@Draft.EndDate.ToString("yyyy-MM-dd")" @onchange="OnEndDateChanged"
                               style="border:1px solid #d7dfe5;border-radius:6px;padding:6px 9px;font-size:13px;width:100%;box-sizing:border-box">
                    </div>
                </div>

                @if (!Draft.IsAllDay)
                {
                    <div style="display:flex;gap:8px">
                        <div style="flex:1">
                            <div style="font-weight:600;color:#1e2a33;margin-bottom:3px">From</div>
                            <select value="@Draft.StartMinutes" @onchange="OnStartMinutesChanged" style="border:1px solid #d7dfe5;border-radius:6px;padding:6px 6px;font-size:13px;width:100%">
                                @foreach (var m in CalendarStyles.TimeOptionsMinutes)
                                {
                                    <option value="@m">@CalendarStyles.FormatMinutes(m)</option>
                                }
                            </select>
                        </div>
                        <div style="flex:1">
                            <div style="font-weight:600;color:#1e2a33;margin-bottom:3px">To</div>
                            <select value="@Draft.EndMinutes" @onchange="OnEndMinutesChanged" style="border:1px solid #d7dfe5;border-radius:6px;padding:6px 6px;font-size:13px;width:100%">
                                @foreach (var m in CalendarStyles.TimeOptionsMinutes)
                                {
                                    <option value="@m">@CalendarStyles.FormatMinutes(m)</option>
                                }
                            </select>
                        </div>
                    </div>
                }

                <div><span @onclick="() => Draft.MarksSheetsUnavailable = !Draft.MarksSheetsUnavailable" style="cursor:pointer;font-weight:600;color:#1e2a33">
                    <input type="checkbox" checked="@Draft.MarksSheetsUnavailable" style="pointer-events:none" /> Marks all sheets unavailable
                </span></div>

                <div><div style="font-weight:600;color:#1e2a33;margin-bottom:3px">Notes <span style="font-weight:400;color:#90a0ab">(optional)</span></div>
                    <input value="@Draft.Notes" @oninput="e => Draft.Notes = e.Value?.ToString()" style="border:1px solid #d7dfe5;border-radius:6px;padding:6px 9px;font-size:13px;width:100%;box-sizing:border-box"></div>
            </div>

            <div style="display:flex;gap:8px;margin-top:14px;font-size:14px;font-weight:600">
                <span @onclick="HandleSaveClick" style="flex:1;text-align:center;background:@(IsSaving ? "#d98e8e" : CanSave ? "#c62f2f" : "#e8b4ae");color:#fff;padding:8px 0;border-radius:6px;cursor:@(IsSaving || !CanSave ? "default" : "pointer")">@(IsSaving ? "Saving..." : "Save")</span>
                <span @onclick="() => OnCancel.InvokeAsync()" style="text-align:center;border:1px solid #d7dfe5;color:#5a7183;padding:8px 16px;border-radius:6px;cursor:pointer">Close</span>
            </div>
            @if (!CanSave)
            {
                <div style="font-size:12px;color:#a02c21;margin-top:6px">@ValidationMessage</div>
            }

            @if (Draft.EditingEvent is not null)
            {
                @if (_confirmingDelete)
                {
                    <div style="background:#fdf1f0;border:1px solid #e8b4ae;border-radius:8px;padding:10px 12px;margin-top:10px;font-size:13px">
                        <div style="color:#a02c21;font-weight:600;margin-bottom:6px">Delete this club event? This can't be undone.</div>
                        <div style="display:flex;gap:8px;font-weight:600">
                            <span @onclick="HandleDeleteClick" style="flex:1;text-align:center;border:1px solid #e8b4ae;color:#a02c21;border-radius:6px;padding:6px 0;cursor:pointer">Yes, delete</span>
                            <span @onclick="() => _confirmingDelete = false" style="flex:1;text-align:center;color:#90a0ab;cursor:pointer;padding:6px 0">Never mind</span>
                        </div>
                    </div>
                }
                else
                {
                    <div style="text-align:center;margin-top:10px">
                        <span @onclick="() => _confirmingDelete = true" style="font-size:12.5px;color:#a02c21;cursor:pointer;text-decoration:underline">Delete Club Event</span>
                    </div>
                }
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public bool IsOpen { get; set; }
    [Parameter, EditorRequired] public ClubEventDraft Draft { get; set; } = new();
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }

    private bool _confirmingDelete;
    private bool _wasOpen;

    // All-day: only the calendar date matters, and Start==End is a valid single-day event (the
    // domain's inclusive End is only converted to Graph's exclusive end-date convention at the
    // service layer, not here). Timed: Start/End carry real times, so an equal date with an
    // end-time at or before the start-time must be rejected too, not just an out-of-order date.
    private bool CanSave => Draft.Category.HasValue
        && !string.IsNullOrWhiteSpace(Draft.Title)
        && (Draft.IsAllDay ? Draft.EndDate.Date >= Draft.StartDate.Date : Draft.End > Draft.Start);

    private string ValidationMessage =>
        !Draft.Category.HasValue ? "Choose a category." :
        string.IsNullOrWhiteSpace(Draft.Title) ? "Event title is required." :
        Draft.IsAllDay ? "The end date must be on or after the start date." :
        "The end time must be after the start time.";

    protected override void OnParametersSet()
    {
        if (IsOpen && !_wasOpen)
        {
            _confirmingDelete = false;
        }
        _wasOpen = IsOpen;
    }

    private Task HandleSaveClick() => (IsSaving || !CanSave) ? Task.CompletedTask : OnSave.InvokeAsync();
    private Task HandleDeleteClick() => OnDelete.InvokeAsync();

    private void OnStartDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d))
        {
            Draft.StartDate = d;
        }
    }

    private void OnEndDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d))
        {
            Draft.EndDate = d;
        }
    }

    private void OnStartMinutesChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var m))
        {
            Draft.StartMinutes = m;
        }
    }

    private void OnEndMinutesChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var m))
        {
            Draft.EndMinutes = m;
        }
    }
}
