@using FacilityScheduler.Domain

@if (IsOpen)
{
    <div style="position:fixed;inset:0;background:rgba(30,42,51,.45);display:flex;align-items:center;justify-content:center;z-index:50">
        <div style="background:#fff;border-radius:10px;box-shadow:0 12px 32px rgba(0,0,0,.35);padding:18px 20px;width:400px;max-height:88vh;overflow:auto">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
                <span style="font-size:15px;font-weight:600;color:#1e2a33">@(Draft.EditingEvent is null ? "New Club Event" : "Edit Club Event")</span>
                <span @onclick="() => OnCancel.InvokeAsync()" style="color:#90a0ab;font-size:14px;cursor:pointer;padding:2px 6px">&#10005;</span>
            </div>

            <div style="display:flex;flex-direction:column;gap:11px;font-size:11px;color:#5a7183">
                <div>
                    <div style="font-weight:600;color:#1e2a33;margin-bottom:3px">Category</div>
                    <div style="display:flex;gap:6px">
                        @foreach (var cat in Enum.GetValues<ClubEventCategory>())
                        {
                            var isSelected = Draft.Category == cat;
                            <span @onclick="() => Draft.Category = cat"
                                  style="background:@(isSelected ? CalendarStyles.ClubEventCategoryColor(cat) : "#fff");color:@(isSelected ? "#fff" : CalendarStyles.ClubEventCategoryColor(cat));border:1px solid @CalendarStyles.ClubEventCategoryColor(cat);padding:3px 12px;border-radius:12px;font-weight:600;cursor:pointer">
                                @cat
                            </span>
                        }
                    </div>
                </div>

                <div><div style="font-weight:600;color:#1e2a33;margin-bottom:3px">Event Title</div>
                    <input value="@Draft.Title" @oninput="e => Draft.Title = e.Value?.ToString()" style="border:1px solid #d7dfe5;border-radius:6px;padding:6px 9px;font-size:11px;width:100%;box-sizing:border-box"></div>

                <div><span @onclick="() => Draft.IsAllDay = !Draft.IsAllDay" style="cursor:pointer;font-weight:600;color:#1e2a33">
                    <input type="checkbox" checked="@Draft.IsAllDay" style="pointer-events:none" /> All day
                </span></div>

                <div style="display:flex;gap:8px;align-items:end">
                    <div style="flex:1">
                        <div style="font-weight:600;color:#1e2a33;margin-bottom:3px">Start date</div>
                        <input type="date" value="@Draft.StartDate.ToString("yyyy-MM-dd")" @onchange="OnStartDateChanged"
                               style="border:1px solid #d7dfe5;border-radius:6px;padding:6px 9px;font-size:11px;width:100%;box-sizing:border-box">
                    </div>
                    <div style="flex:1">
                        <div style="font-weight:600;color:#1e2a33;margin-bottom:3px">End date</div>
                        <input type="date" value="@Draft.EndDate.ToString("yyyy-MM-dd")" @onchange="OnEndDateChanged"
                               style="border:1px solid #d7dfe5;border-radius:6px;padding:6px 9px;font-size:11px;width:100%;box-sizing:border-box">
                    </div>
                </div>

                @if (!Draft.IsAllDay)
                {
                    <div style="display:flex;gap:8px">
                        <div style="flex:1">
                            <div style="font-weight:600;color:#1e2a33;margin-bottom:3px">From</div>
                            <select value="@Draft.StartHour" @onchange="OnStartHourChanged" style="border:1px solid #d7dfe5;border-radius:6px;padding:6px 6px;font-size:11px;width:100%">
                                @foreach (var h in HourOptions)
                                {
                                    <option value="@h">@FormatHour(h)</option>
                                }
                            </select>
                        </div>
                        <div style="flex:1">
                            <div style="font-weight:600;color:#1e2a33;margin-bottom:3px">To</div>
                            <select value="@Draft.EndHour" @onchange="OnEndHourChanged" style="border:1px solid #d7dfe5;border-radius:6px;padding:6px 6px;font-size:11px;width:100%">
                                @foreach (var h in HourOptions)
                                {
                                    <option value="@h">@FormatHour(h)</option>
                                }
                            </select>
                        </div>
                    </div>
                }

                <div><span @onclick="() => Draft.MarksSheetsUnavailable = !Draft.MarksSheetsUnavailable" style="cursor:pointer;font-weight:600;color:#1e2a33">
                    <input type="checkbox" checked="@Draft.MarksSheetsUnavailable" style="pointer-events:none" /> Marks all sheets unavailable
                </span></div>

                <div><div style="font-weight:600;color:#1e2a33;margin-bottom:3px">Notes <span style="font-weight:400;color:#90a0ab">(optional)</span></div>
                    <input value="@Draft.Notes" @oninput="e => Draft.Notes = e.Value?.ToString()" style="border:1px solid #d7dfe5;border-radius:6px;padding:6px 9px;font-size:11px;width:100%;box-sizing:border-box"></div>
            </div>

            <div style="display:flex;gap:8px;margin-top:14px;font-size:12px;font-weight:600">
                <span @onclick="HandleSaveClick" style="flex:1;text-align:center;background:@(IsSaving ? "#d98e8e" : CanSave ? "#c62f2f" : "#e8b4ae");color:#fff;padding:8px 0;border-radius:6px;cursor:@(IsSaving || !CanSave ? "default" : "pointer")">@(IsSaving ? "Saving..." : "Save")</span>
                <span @onclick="() => OnCancel.InvokeAsync()" style="text-align:center;border:1px solid #d7dfe5;color:#5a7183;padding:8px 16px;border-radius:6px;cursor:pointer">Close</span>
            </div>
            @if (!CanSave)
            {
                <div style="font-size:10px;color:#a02c21;margin-top:6px">@ValidationMessage</div>
            }

            @if (Draft.EditingEvent is not null)
            {
                @if (_confirmingDelete)
                {
                    <div style="background:#fdf1f0;border:1px solid #e8b4ae;border-radius:8px;padding:10px 12px;margin-top:10px;font-size:11px">
                        <div style="color:#a02c21;font-weight:600;margin-bottom:6px">Delete this club event? This can't be undone.</div>
                        <div style="display:flex;gap:8px;font-weight:600">
                            <span @onclick="HandleDeleteClick" style="flex:1;text-align:center;border:1px solid #e8b4ae;color:#a02c21;border-radius:6px;padding:6px 0;cursor:pointer">Yes, delete</span>
                            <span @onclick="() => _confirmingDelete = false" style="flex:1;text-align:center;color:#90a0ab;cursor:pointer;padding:6px 0">Never mind</span>
                        </div>
                    </div>
                }
                else
                {
                    <div style="text-align:center;margin-top:10px">
                        <span @onclick="() => _confirmingDelete = true" style="font-size:10.5px;color:#a02c21;cursor:pointer;text-decoration:underline">Delete Club Event</span>
                    </div>
                }
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public bool IsOpen { get; set; }
    [Parameter, EditorRequired] public ClubEventDraft Draft { get; set; } = new();
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }

    private static readonly int[] HourOptions = Enumerable.Range(6, 18).ToArray();

    private bool _confirmingDelete;
    private bool _wasOpen;

    private bool CanSave => !string.IsNullOrWhiteSpace(Draft.Title) && Draft.EndDate.Date >= Draft.StartDate.Date;

    private string ValidationMessage =>
        string.IsNullOrWhiteSpace(Draft.Title) ? "Event title is required." :
        "The end date must be on or after the start date.";

    protected override void OnParametersSet()
    {
        if (IsOpen && !_wasOpen)
        {
            _confirmingDelete = false;
        }
        _wasOpen = IsOpen;
    }

    private Task HandleSaveClick() => (IsSaving || !CanSave) ? Task.CompletedTask : OnSave.InvokeAsync();
    private Task HandleDeleteClick() => OnDelete.InvokeAsync();

    private void OnStartDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d))
        {
            Draft.StartDate = d;
        }
    }

    private void OnEndDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d))
        {
            Draft.EndDate = d;
        }
    }

    private void OnStartHourChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var h))
        {
            Draft.StartHour = h;
        }
    }

    private void OnEndHourChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var h))
        {
            Draft.EndHour = h;
        }
    }

    private static string FormatHour(int hour) => new DateTime(1, 1, 1, hour, 0, 0).ToString("h tt");
}
