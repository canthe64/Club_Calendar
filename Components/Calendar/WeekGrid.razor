@using FacilityScheduler.Domain

<div style="min-width:900px;border:1px solid #e7ecef;border-radius:8px;padding:10px;background:#fff">
    <div style="display:flex;gap:3px;font-size:13px">
        <div style="width:56px;flex-shrink:0">
            <div style="height:@(HeaderRowHeightPx)px"></div>
            @if (WeekAllDayRowHeightPx > 0)
            {
                <div style="height:@(WeekAllDayRowHeightPx)px"></div>
            }
            @foreach (var hour in CalendarStyles.HourRows)
            {
                <div style="box-sizing:border-box;height:@(CalendarStyles.RowHeightPx)px;color:#90a0ab;font-size:12.5px;text-align:right;padding:2px 8px 0 0;font-weight:600">@CalendarStyles.FormatHour(hour)</div>
                <div style="height:@(CalendarStyles.RowGapPx)px"></div>
            }
        </div>
        @foreach (var day in WeekDays)
        {
            var dayAllDayEvents = AllDayEventsForDay(day);
            var laidOutItems = CalendarStyles.LayoutLanes(TimedItemsForDay(day), i => i.Start, i => i.End);
            <div style="flex:1;min-width:0">
                <div @onclick="() => OnDayClick.InvokeAsync(day)" style="box-sizing:border-box;height:@(HeaderRowHeightPx)px;text-align:center;cursor:pointer;padding-bottom:3px;border-bottom:1px solid #f2f5f7">
                    <div style="font-weight:600;color:#1e2a33;font-size:12.5px">@day.ToString("ddd")</div>
                    <div style="color:#90a0ab;font-size:12.5px">@day.ToString("MMM d")</div>
                </div>
                @if (WeekAllDayRowHeightPx > 0)
                {
                    <div style="display:flex;flex-direction:column;gap:2px;height:@(WeekAllDayRowHeightPx)px;padding:2px 0;box-sizing:border-box">
                        @foreach (var ce in dayAllDayEvents)
                        {
                            var (ceContBefore, ceContAfter) = CalendarStyles.ContinuationMarks(ce.Start, ce.End, day);
                            var ceText = ce.MarksSheetsUnavailable ? $"{ce.Title} - all sheets" : ce.Title;
                            <div @onclick="() => OnClubEventClick.InvokeAsync(ce)"
                                 style="background:@CalendarStyles.ClubEventCategoryColor(ce.Category);color:#fff;border:@CalendarStyles.ClubEventBorderStyle;box-sizing:border-box;border-radius:4px;padding:2px 6px;font-size:12px;font-weight:600;cursor:pointer;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@(ceContBefore ? "← " : "")@ceText@(ceContAfter ? " →" : "")</div>
                        }
                    </div>
                }
                <div @onclick="() => OnDayClick.InvokeAsync(day)" style="position:relative;cursor:pointer">
                    @foreach (var hour in CalendarStyles.HourRows)
                    {
                        <div style="box-sizing:border-box;height:@(CalendarStyles.RowHeightPx)px;margin-bottom:@(CalendarStyles.RowGapPx)px;border-radius:5px;background:@CalendarStyles.EmptySlotBg;border:1px solid #eef1f3"></div>
                    }
                    @foreach (var laid in laidOutItems)
                    {
                        var widthPct = 100.0 / laid.LaneCount;
                        var leftPct = laid.Lane * widthPct;
                        @if (laid.Item.ClubEvent is { } ce)
                        {
                            // Same reasoning as booking titles: ce.Start belongs to the event's actual
                            // first day only - on a later day of a multi-day timed club event, this
                            // would otherwise read as starting at the same hour every day.
                            var (ceContBefore, ceContAfter) = CalendarStyles.ContinuationMarks(ce.Start, ce.End, day);
                            var ceLabel = day.Date == ce.Start.Date ? $"{CalendarStyles.CellStartTimeLabel(ce.Start)} - {ce.Title}" : ce.Title;
                            <div @onclick="() => OnClubEventClick.InvokeAsync(ce)" @onclick:stopPropagation="true"
                                 style="box-sizing:border-box;position:absolute;top:@(CalendarStyles.TopPx(laid.Item.Start, day))px;left:@(leftPct)%;width:calc(@(widthPct)% - 2px);height:@(CalendarStyles.HeightPx(laid.Item.Start, laid.Item.End, day))px;z-index:2;border-radius:5px;background:@(ce.MarksSheetsUnavailable ? "#a02c21" : CalendarStyles.ClubEventCategoryColor(ce.Category));border:@CalendarStyles.ClubEventBorderStyle;color:#fff;padding:2px 5px;overflow:hidden;cursor:pointer;font-size:12px;font-weight:600">@(ceContBefore ? "← " : "")@ceLabel@(ceContAfter ? " →" : "")</div>
                        }
                        else if (laid.Item.Booking is { } b)
                        {
                            var (contBefore, contAfter) = CalendarStyles.ContinuationMarks(b.Start, b.End, day);
                            // The start time belongs to the booking's actual first day only - repeating
                            // it on every later day reads as a daily recurrence rather than one
                            // continuous event. The arrows alone carry that meaning on continuation days.
                            var label = contBefore
                                ? BookingLabel(b, laid.Item.SheetCount)
                                : $"{CalendarStyles.CellStartTimeLabel(laid.Item.Start)} - {BookingLabel(b, laid.Item.SheetCount)}";
                            <div @onclick="() => OnBookingClick.InvokeAsync(b)" @onclick:stopPropagation="true"
                                 style="box-sizing:border-box;position:absolute;top:@(CalendarStyles.TopPx(laid.Item.Start, day))px;left:@(leftPct)%;width:calc(@(widthPct)% - 2px);height:@(CalendarStyles.HeightPx(laid.Item.Start, laid.Item.End, day))px;z-index:1;border-radius:5px;background:@CalendarStyles.BackgroundStyle(b);border:@CalendarStyles.BorderStyle(b);color:@CalendarStyles.TextColorStyle(b);padding:2px 5px;overflow:hidden;cursor:pointer">
                                <div style="font-size:12px;font-weight:600">@(contBefore ? "← " : "")@label@(contAfter ? " →" : "")</div>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public List<SheetBooking> Bookings { get; set; } = [];
    [Parameter] public List<ClubEvent> ClubEvents { get; set; } = [];
    [Parameter, EditorRequired] public DateTime WeekStart { get; set; }
    [Parameter] public EventCallback<SheetBooking> OnBookingClick { get; set; }
    [Parameter] public EventCallback<ClubEvent> OnClubEventClick { get; set; }
    [Parameter] public EventCallback<DateTime> OnDayClick { get; set; }

    private const double AllDayChipHeightPx = 18;
    private const double AllDayChipGapPx = 2;
    private const double HeaderRowHeightPx = 32;

    private List<DateTime> WeekDays => [.. Enumerable.Range(0, 7).Select(i => WeekStart.Date.AddDays(i))];

    private List<ClubEvent> AllDayEventsForDay(DateTime day) =>
        ClubEvents.Where(ce => ce.IsAllDay && ce.Start.Date <= day.Date && day.Date <= ce.End.Date)
            .OrderBy(ce => ce.Title)
            .ToList();

    // Every day column's hourly grid must start at the same vertical offset, so the reserved
    // all-day row height is sized off the week's busiest day, not each day's own count - a day
    // with fewer (or zero) all-day events still reserves the same space, keeping the hour axis
    // (shared in the left gutter) aligned under every column.
    private double WeekAllDayRowHeightPx
    {
        get
        {
            var maxCount = WeekDays.Select(d => AllDayEventsForDay(d).Count).DefaultIfEmpty(0).Max();
            return maxCount == 0 ? 0 : maxCount * AllDayChipHeightPx + Math.Max(0, maxCount - 1) * AllDayChipGapPx + 4;
        }
    }

    private static string BookingLabel(SheetBooking b, int sheetCount)
    {
        var title = CalendarStyles.BookingDisplayTitle(b);
        return sheetCount > 1 ? $"{title} · {sheetCount} sheets" : title;
    }

    private sealed record DayItem(DateTime Start, DateTime End, ClubEvent? ClubEvent, SheetBooking? Booking, int SheetCount);

    // Timed club events (whole-club, not sheet-specific) and sheet bookings (consolidated across
    // sheets sharing one BookingGroupId, per the user's "collapse identical multi-sheet bookings"
    // ask) are peers here - both just "things happening that day" competing for the same hourly
    // timeline and lane space (CalendarStyles.LayoutLanes). All-day events are handled separately
    // above (no specific hour to place them at).
    private List<DayItem> TimedItemsForDay(DateTime day)
    {
        var timedClubEvents = ClubEvents
            .Where(ce => !ce.IsAllDay && ce.Start.Date <= day.Date && day.Date <= ce.End.Date)
            .Select(ce => new DayItem(ce.Start, ce.End, ce, null, 0));

        var consolidatedBookings = Bookings
            .Where(b => CalendarStyles.OccursOnDay(b.Start, b.End, day.Date))
            .GroupBy(CalendarStyles.BookingGroupKey)
            .Select(g => new DayItem(g.First().Start, g.First().End, null, g.First(), g.Count()));

        return timedClubEvents.Concat(consolidatedBookings).OrderBy(i => i.Start).ToList();
    }
}
