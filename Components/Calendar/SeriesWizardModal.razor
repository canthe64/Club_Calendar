@using FacilityScheduler.Domain
@using FacilityScheduler.Services
@inject FacilityConfiguration Facility

@if (IsOpen)
{
    <div style="position:fixed;inset:0;background:rgba(30,42,51,.45);display:flex;align-items:center;justify-content:center;z-index:50">
        <div style="background:#fff;border-radius:10px;box-shadow:0 12px 32px rgba(0,0,0,.35);padding:18px 20px;width:720px;max-width:94vw;max-height:88vh;overflow:auto">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px">
                <span style="font-size:17px;font-weight:600;color:#1e2a33">Create Recurring Booking</span>
                <span @onclick="() => OnCancel.InvokeAsync()" style="color:#90a0ab;font-size:16px;cursor:pointer;padding:2px 6px">&#10005;</span>
            </div>

            @if (Step == 1)
            {
                <div style="display:flex;flex-direction:column;gap:11px;font-size:13px;color:#5a7183;margin-top:10px">
                    <div>
                        <div style="font-weight:600;color:#1e2a33;margin-bottom:3px">Category</div>
                        <div style="display:flex;gap:6px;flex-wrap:wrap">
                            @foreach (var cat in CalendarStyles.SheetCategories)
                            {
                                var isSelected = Draft.Category == cat;
                                <span @onclick="() => Draft.SetCategory(cat)"
                                      style="background:@(isSelected ? CalendarStyles.CategoryColor(cat) : "#fff");color:@(isSelected ? "#fff" : CalendarStyles.CategoryColor(cat));border:1px solid @CalendarStyles.CategoryColor(cat);padding:3px 12px;border-radius:12px;font-weight:600;cursor:pointer">
                                    @CalendarStyles.CategoryLabel(cat)
                                </span>
                            }
                        </div>
                    </div>

                    <div><div style="font-weight:600;color:#1e2a33;margin-bottom:3px">Event Title</div>
                        <input value="@Draft.RenterName" @oninput="e => Draft.RenterName = e.Value?.ToString()" style="border:1px solid #d7dfe5;border-radius:6px;padding:6px 9px;font-size:13px;width:100%;box-sizing:border-box"></div>

                    <div>
                        <div style="font-weight:600;color:#1e2a33;margin-bottom:3px">Sheets <span style="font-weight:400;color:#90a0ab">— tap to toggle</span></div>
                        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap">
                            @foreach (var sheet in Facility.SheetMailboxes)
                            {
                                var isSelected = Draft.SelectedSheets.Contains(sheet);
                                <span @onclick="() => ToggleSheet(sheet)"
                                      style="background:@(isSelected ? "#2d5f8a" : "#fff");color:@(isSelected ? "#fff" : "#2d5f8a");border:1px solid #2d5f8a;padding:5px 0;width:72px;text-align:center;border-radius:6px;font-weight:600;cursor:pointer">
                                    @DayGridSheetLabel(sheet)
                                </span>
                            }
                            <span @onclick="SelectAllSheets"
                                  style="border:1px dashed #2d5f8a;color:#2d5f8a;padding:5px 10px;border-radius:6px;font-weight:600;cursor:pointer">
                                All Sheets
                            </span>
                        </div>
                    </div>

                    <div style="display:flex;gap:8px;align-items:end">
                        <div style="flex:1">
                            <div style="font-weight:600;color:#1e2a33;margin-bottom:3px">First date</div>
                            <input type="date" value="@Draft.FirstDate.ToString("yyyy-MM-dd")" @onchange="OnFirstDateChanged"
                                   style="border:1px solid #d7dfe5;border-radius:6px;padding:6px 9px;font-size:13px;width:100%;box-sizing:border-box">
                        </div>
                        <div style="flex:1">
                            <div style="font-weight:600;color:#1e2a33;margin-bottom:3px">Last date</div>
                            <input type="date" value="@Draft.LastDate.ToString("yyyy-MM-dd")" @onchange="OnLastDateChanged"
                                   style="border:1px solid #d7dfe5;border-radius:6px;padding:6px 9px;font-size:13px;width:100%;box-sizing:border-box">
                        </div>
                    </div>
                    <div style="font-size:12px;color:#90a0ab">Repeats weekly on @Draft.FirstDate.ToString("dddd")s, based on the first date above.</div>

                    <div style="display:flex;gap:8px;align-items:end">
                        <div style="flex:1">
                            <div style="font-weight:600;color:#1e2a33;margin-bottom:3px">From</div>
                            <select value="@Draft.StartMinutes" @onchange="OnStartMinutesChanged" style="border:1px solid #d7dfe5;border-radius:6px;padding:6px 6px;font-size:13px;width:100%">
                                @foreach (var m in CalendarStyles.TimeOptionsMinutes)
                                {
                                    <option value="@m">@CalendarStyles.FormatMinutes(m)</option>
                                }
                            </select>
                        </div>
                        <div style="flex:1">
                            <div style="font-weight:600;color:#1e2a33;margin-bottom:3px">To</div>
                            <select value="@Draft.EndMinutes" @onchange="OnEndMinutesChanged" style="border:1px solid #d7dfe5;border-radius:6px;padding:6px 6px;font-size:13px;width:100%">
                                @foreach (var m in CalendarStyles.TimeOptionsMinutes)
                                {
                                    <option value="@m">@CalendarStyles.FormatMinutes(m)</option>
                                }
                            </select>
                        </div>
                    </div>

                    @if (Draft.Category == BookingCategory.GroupEvent)
                    {
                        <div>
                            <div style="font-weight:600;color:#1e2a33;margin-bottom:3px">Booking status</div>
                            <div style="display:flex;gap:6px">
                                <span @onclick="() => Draft.CreateAsConfirmed = false"
                                      style="flex:1;text-align:center;background:@(Draft.CreateAsConfirmed == false ? "#2d5f8a" : "#fff");color:@(Draft.CreateAsConfirmed == false ? "#fff" : "#2d5f8a");border:1px solid #2d5f8a;padding:5px 0;border-radius:6px;font-weight:600;cursor:pointer">
                                    Hold for future group event
                                </span>
                                <span @onclick="() => Draft.CreateAsConfirmed = true"
                                      style="flex:1;text-align:center;background:@(Draft.CreateAsConfirmed == true ? "#2d5f8a" : "#fff");color:@(Draft.CreateAsConfirmed == true ? "#fff" : "#2d5f8a");border:1px solid #2d5f8a;padding:5px 0;border-radius:6px;font-weight:600;cursor:pointer">
                                    Confirmed booking
                                </span>
                            </div>
                        </div>
                        <div style="display:flex;gap:8px">
                            <div style="flex:1"><div style="font-weight:600;color:#1e2a33;margin-bottom:3px">Phone <span style="font-weight:400;color:#90a0ab">(optional)</span></div>
                                <input value="@Draft.RenterPhone" @oninput="e => Draft.RenterPhone = e.Value?.ToString()" style="border:1px solid #d7dfe5;border-radius:6px;padding:6px 9px;font-size:13px;width:100%;box-sizing:border-box"></div>
                            <div style="flex:1"><div style="font-weight:600;color:#1e2a33;margin-bottom:3px">Email <span style="font-weight:400;color:#90a0ab">(optional)</span></div>
                                <input value="@Draft.RenterEmail" @oninput="e => Draft.RenterEmail = e.Value?.ToString()" style="border:1px solid #d7dfe5;border-radius:6px;padding:6px 9px;font-size:13px;width:100%;box-sizing:border-box"></div>
                        </div>
                    }

                    <div><div style="font-weight:600;color:#1e2a33;margin-bottom:3px">Notes <span style="font-weight:400;color:#90a0ab">(optional)</span></div>
                        <input value="@Draft.Notes" @oninput="e => Draft.Notes = e.Value?.ToString()" style="border:1px solid #d7dfe5;border-radius:6px;padding:6px 9px;font-size:13px;width:100%;box-sizing:border-box"></div>
                </div>

                <div style="display:flex;gap:8px;margin-top:16px;font-size:14px;font-weight:600">
                    <span @onclick="HandlePreviewClick" style="flex:1;text-align:center;background:@(CanPreview ? "#c62f2f" : "#e8b4ae");color:#fff;padding:8px 0;border-radius:6px;cursor:@(CanPreview ? "pointer" : "default")">
                        @(IsLoadingPreview ? "Checking..." : $"Review {Draft.ComputeCandidateDates().Count} dates →")
                    </span>
                    <span @onclick="() => OnCancel.InvokeAsync()" style="text-align:center;border:1px solid #d7dfe5;color:#5a7183;padding:8px 16px;border-radius:6px;cursor:pointer">Cancel</span>
                </div>
                @if (IsLoadingPreview)
                {
                    <div style="font-size:12px;color:#5a7183;margin-top:6px">Checking availability...</div>
                }
                else if (!HasValidSelection)
                {
                    <div style="font-size:12px;color:#a02c21;margin-top:6px">@ValidationMessage</div>
                }
            }
            else
            {
                <div style="font-size:13px;color:#5a7183;margin:10px 0">
                    <b style="color:#1e2a33">@(string.IsNullOrWhiteSpace(Draft.RenterName) ? Draft.Category.ToString() : Draft.RenterName)</b>
                    · @string.Join(", ", Draft.SelectedSheets.Select(DayGridSheetLabel))
                    · @CalendarStyles.FormatMinutes(Draft.StartMinutes)-@CalendarStyles.FormatMinutes(Draft.EndMinutes)
                </div>
                @if (!string.IsNullOrWhiteSpace(SeasonWarning))
                {
                    <div style="display:flex;align-items:center;gap:6px;background:#fdf8ec;border:1px solid #f0d58c;border-radius:6px;padding:7px 10px;margin-bottom:8px;font-size:12.5px;color:#8a6d1f">
                        @SeasonWarning
                    </div>
                }
                <div style="display:flex;align-items:center;gap:6px;background:@(ActiveConflictCount == 0 ? "#eaf6ec" : "#fdf1f0");border:1px solid @(ActiveConflictCount == 0 ? "#a8d5b5" : "#e8b4ae");border-radius:6px;padding:7px 10px;margin-bottom:8px;font-size:13px;font-weight:600;color:@(ActiveConflictCount == 0 ? "#2c7a43" : "#a02c21")">
                    @StatusBannerText
                </div>
                <div style="display:flex;flex-direction:column;gap:5px;font-size:13.5px;max-height:340px;overflow:auto">
                    @foreach (var date in Draft.ComputeCandidateDates())
                    {
                        var isSeasonExcluded = SeasonExcludedDates.Contains(date);
                        var isSkipped = Draft.SkippedDates.Contains(date);
                        var hasConflict = Conflicts.TryGetValue(date, out var conflictList) && conflictList.Count > 0;
                        <div style="display:flex;justify-content:space-between;align-items:center;background:@(isSeasonExcluded ? "#f1efec" : isSkipped ? "#f6f8f9" : hasConflict ? "#fdf1f0" : "#eaf1f8");border:1px solid @(isSeasonExcluded ? "#c1ccd4" : isSkipped ? "#e7ecef" : hasConflict ? "#e8b4ae" : "#a9c7e4");border-radius:6px;padding:7px 10px">
                            <span style="color:@(isSeasonExcluded || isSkipped ? "#90a0ab" : "#1e2a33");text-decoration:@(isSeasonExcluded || isSkipped ? "line-through" : "none")">@date.ToString("ddd, MMM d")</span>
                            @if (isSeasonExcluded)
                            {
                                @* No Skip/Include toggle - unlike a real conflict, an out-of-season date isn't
                                   staff's call to override, so there's nothing to toggle back to Include. *@
                                <span style="font-size:12px;color:#5a7183;font-style:italic">outside the booking season</span>
                            }
                            else
                            {
                                <span style="display:flex;gap:8px;align-items:center">
                                    @if (hasConflict && !isSkipped)
                                    {
                                        <span style="font-size:12px;color:#a02c21">conflicts with @conflictList!.Count booking(s)</span>
                                    }
                                    <span @onclick="() => ToggleSkip(date)" style="border:1px solid #d7dfe5;color:#2d5f8a;border-radius:5px;padding:2px 9px;font-weight:600;font-size:12.5px;cursor:pointer">@(isSkipped ? "Include" : "Skip")</span>
                                </span>
                            }
                        </div>
                    }
                </div>
                <div style="display:flex;gap:8px;margin-top:14px;font-size:14px;font-weight:600">
                    <span @onclick="HandleCreateClick" style="flex:1;text-align:center;background:@(IsSaving || DatesToCreateCount == 0 ? "#d98e8e" : "#c62f2f");color:#fff;padding:8px 0;border-radius:6px;cursor:@(IsSaving || DatesToCreateCount == 0 ? "default" : "pointer")">
                        @(IsSaving ? "Creating..." : $"Create series — {DatesToCreateCount} dates")
                    </span>
                    <span @onclick="() => OnBack.InvokeAsync()" style="text-align:center;border:1px solid #d7dfe5;color:#5a7183;padding:8px 14px;border-radius:6px;cursor:pointer">&#8592; Back</span>
                </div>
                @if (DatesToCreateCount == 0)
                {
                    <div style="font-size:12px;color:#a02c21;margin-top:8px">Every date is skipped or outside the booking season - nothing would be created.</div>
                }
                else
                {
                    <div style="font-size:12px;color:#90a0ab;margin-top:8px">Skipping is always your explicit choice — conflicts are flagged, never auto-skipped.</div>
                }
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public bool IsOpen { get; set; }
    [Parameter, EditorRequired] public SeriesDraft Draft { get; set; } = new();
    [Parameter, EditorRequired] public int Step { get; set; } = 1;
    [Parameter] public Dictionary<DateTime, List<SheetBooking>> Conflicts { get; set; } = [];
    [Parameter] public bool IsLoadingPreview { get; set; }
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public string? SeasonWarning { get; set; }
    [Parameter] public HashSet<DateTime> SeasonExcludedDates { get; set; } = [];
    [Parameter] public EventCallback OnPreview { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback OnCreate { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private bool HasValidSelection => Draft.Category.HasValue
        && Draft.SelectedSheets.Count > 0
        && Draft.LastDate.Date >= Draft.FirstDate.Date
        && Draft.EndMinutes > Draft.StartMinutes
        && !string.IsNullOrWhiteSpace(Draft.RenterName)
        && (Draft.Category != BookingCategory.GroupEvent || Draft.CreateAsConfirmed.HasValue);

    private bool CanPreview => HasValidSelection && !IsLoadingPreview;

    private string ValidationMessage =>
        !Draft.Category.HasValue ? "Choose a category." :
        Draft.SelectedSheets.Count == 0 ? "Select at least one sheet." :
        Draft.LastDate.Date < Draft.FirstDate.Date ? "The last date must be on or after the first date." :
        Draft.EndMinutes <= Draft.StartMinutes ? "The end time must be after the start time." :
        string.IsNullOrWhiteSpace(Draft.RenterName) ? "Event title is required." :
        "Choose Hold for future group event or Confirmed booking.";

    private int ActiveConflictCount => Draft.ComputeCandidateDates()
        .Where(d => !Draft.SkippedDates.Contains(d))
        .Count(d => Conflicts.TryGetValue(d, out var c) && c.Count > 0);

    private int DatesToCreateCount => Draft.ComputeCandidateDates().Count - Draft.SkippedDates.Count;

    private string StatusBannerText => BuildStatusBannerText(ActiveConflictCount, SeasonExcludedDates.Count);

    // "Clear to create" is only accurate when every candidate date will actually be created - with
    // season exclusions in play that's no longer guaranteed even at zero scheduling conflicts, and
    // saying so unconditionally read as contradicting the season warning directly above it (live-found
    // 2026-08-18: staff saw a green "clear to create" banner sitting right beside a yellow one saying
    // a date would be dropped). internal static, reached via InternalsVisibleTo, so testable directly.
    internal static string BuildStatusBannerText(int activeConflictCount, int seasonExcludedCount) =>
        (activeConflictCount, seasonExcludedCount) switch
        {
            (0, 0) => "✓ No conflicts — clear to create",
            (0, > 0) => $"✓ No scheduling conflicts — {seasonExcludedCount} date(s) below excluded for being outside the season",
            _ => $"⚠ {activeConflictCount} date(s) still have conflicts",
        };

    private Task HandlePreviewClick() => CanPreview ? OnPreview.InvokeAsync() : Task.CompletedTask;
    private Task HandleCreateClick() => IsSaving || DatesToCreateCount == 0 ? Task.CompletedTask : OnCreate.InvokeAsync();

    private void ToggleSheet(string sheet)
    {
        if (!Draft.SelectedSheets.Remove(sheet))
        {
            Draft.SelectedSheets.Add(sheet);
        }
    }

    private void SelectAllSheets() => Draft.SelectedSheets = [.. Facility.SheetMailboxes];

    private void ToggleSkip(DateTime date)
    {
        if (!Draft.SkippedDates.Remove(date))
        {
            Draft.SkippedDates.Add(date);
        }
    }

    private void OnFirstDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d))
        {
            Draft.FirstDate = d;
        }
    }

    private void OnLastDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d))
        {
            Draft.LastDate = d;
        }
    }

    private void OnStartMinutesChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var m))
        {
            Draft.StartMinutes = m;
        }
    }

    private void OnEndMinutesChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var m))
        {
            Draft.EndMinutes = m;
        }
    }

    private static string DayGridSheetLabel(string sheetMailbox)
    {
        var localPart = sheetMailbox.Split('@')[0];
        var digits = new string(localPart.Where(char.IsDigit).ToArray());
        return digits.Length > 0 ? $"Sheet {digits}" : localPart;
    }
}
