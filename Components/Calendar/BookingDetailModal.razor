@using FacilityScheduler.Domain

@if (Group is { Count: > 0 })
{
    var first = Group[0];
    <div @onclick="() => OnClose.InvokeAsync()" style="position:fixed;inset:0;background:rgba(30,42,51,.45);display:flex;align-items:center;justify-content:center;z-index:50">
        <div @onclick:stopPropagation="true" style="background:#fff;border-radius:10px;box-shadow:0 12px 32px rgba(0,0,0,.35);padding:18px 20px;width:440px">
            <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:2px">
                <span style="font-size:17px;font-weight:600;color:#1e2a33">@CalendarStyles.BookingDisplayTitle(first)</span>
                <span style="background:@CalendarStyles.CategoryLightBg(first.Category);color:@CalendarStyles.CategoryColor(first.Category);font-size:12px;font-weight:600;padding:2px 9px;border-radius:10px">@first.State</span>
            </div>
            <div style="font-size:13px;color:#5a7183;margin-bottom:12px">@first.Start.ToString("dddd, MMM d, h:mmtt")-@first.End.ToString("h:mmtt")</div>

            <div style="display:flex;justify-content:space-between;border-bottom:1px solid #eef1f3;padding:6px 0;font-size:13.5px">
                <span style="color:#5a7183">Sheets</span><span style="color:#1e2a33">@string.Join(", ", Group.Select(g => SheetLabel(g.SheetMailbox)))</span>
            </div>
            <div style="display:flex;justify-content:space-between;border-bottom:1px solid #eef1f3;padding:6px 0;font-size:13.5px">
                <span style="color:#5a7183">Category</span><span style="color:#1e2a33">@first.Category</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(first.RenterPhone))
            {
                <div style="display:flex;justify-content:space-between;border-bottom:1px solid #eef1f3;padding:6px 0;font-size:13.5px">
                    <span style="color:#5a7183">Phone</span><span style="color:#1e2a33">@first.RenterPhone</span>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(first.RenterEmail))
            {
                <div style="display:flex;justify-content:space-between;border-bottom:1px solid #eef1f3;padding:6px 0;font-size:13.5px">
                    <span style="color:#5a7183">Email</span><span style="color:#1e2a33">@first.RenterEmail</span>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(first.Notes))
            {
                <div style="display:flex;justify-content:space-between;border-bottom:1px solid #eef1f3;padding:6px 0;font-size:13.5px">
                    <span style="color:#5a7183">Notes</span><span style="color:#1e2a33">@first.Notes</span>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(first.BookedBy))
            {
                <div style="display:flex;justify-content:space-between;border-bottom:1px solid #eef1f3;padding:6px 0;font-size:13.5px">
                    <span style="color:#5a7183">Booked by</span><span style="color:#1e2a33">@first.BookedBy</span>
                </div>
            }

            @if (first.Category == BookingCategory.PracticeIce && first.State == BookingState.Hold)
            {
                <div style="margin-top:10px;padding:8px 12px;border:1px solid #f0d58c;background:#fdf8ec;border-radius:6px;color:#8a6d1f;font-size:13.5px">
                    Awaiting approval - <a href="/practice-ice/approvals" style="color:#8a6d1f;font-weight:600">review in Practice Ice Requests</a>
                </div>
            }

            <div style="display:flex;gap:8px;margin-top:14px;font-size:13.5px;font-weight:600">
                @if (ReadOnly)
                {
                    @* Reached from the search page - Edit/Cancel there would be a second, untested
                       copy of the partial-sheet-edit and group-id-split rules SaveDraft owns on the
                       calendar page (D88). Send staff to the working flow instead. *@
                    <span @onclick="() => OnOpenOnCalendar.InvokeAsync(Group)" style="flex:1;text-align:center;border:1px solid #d7dfe5;color:#2d5f8a;border-radius:6px;padding:7px 0;cursor:pointer">Open on calendar</span>
                    <span @onclick="() => OnClose.InvokeAsync()" style="text-align:center;border:1px solid #d7dfe5;color:#5a7183;border-radius:6px;padding:7px 14px;cursor:pointer">Close</span>
                }
                else
                {
                    <span @onclick="() => OnEdit.InvokeAsync(Group)" style="flex:1;text-align:center;border:1px solid #d7dfe5;color:#2d5f8a;border-radius:6px;padding:7px 0;cursor:pointer">Edit booking…</span>
                    <span @onclick="() => OnCancelBooking.InvokeAsync(Group)" style="flex:1;text-align:center;border:1px solid #e8b4ae;color:#a02c21;border-radius:6px;padding:7px 0;cursor:pointer">Cancel Booking</span>
                    <span @onclick="() => OnClose.InvokeAsync()" style="text-align:center;border:1px solid #d7dfe5;color:#5a7183;border-radius:6px;padding:7px 14px;cursor:pointer">Close</span>
                }
            </div>

            @* "Edit booking…" above edits only the date that was clicked. For a series, the far more
               common intent is "the league is called the wrong thing" - which means every date. The
               two are separate buttons rather than a prompt so neither is a guess. Suppressed in
               ReadOnly mode along with the ordinary Edit/Cancel row above, same reasoning. *@
            @if (!ReadOnly && Group.Any(g => g.SeriesMasterId is not null))
            {
                <div style="margin-top:10px;border-top:1px solid #e7ecef;padding-top:10px">
                    <div style="font-size:12px;color:#90a0ab;margin-bottom:6px">Part of a recurring series</div>
                    <div style="display:flex;gap:8px;font-size:13.5px;font-weight:600">
                        <span @onclick="() => OnEditSeries.InvokeAsync(Group)" style="flex:1;text-align:center;border:1px solid #d7dfe5;color:#2d5f8a;border-radius:6px;padding:7px 0;cursor:pointer">Edit whole series…</span>
                        <span @onclick="() => OnCancelSeries.InvokeAsync(Group)" style="flex:1;text-align:center;border:1px solid #e8b4ae;color:#a02c21;border-radius:6px;padding:7px 0;cursor:pointer">Cancel entire series</span>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public List<SheetBooking>? Group { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<List<SheetBooking>> OnEdit { get; set; }
    [Parameter] public EventCallback<List<SheetBooking>> OnCancelBooking { get; set; }
    [Parameter] public EventCallback<List<SheetBooking>> OnCancelSeries { get; set; }
    [Parameter] public EventCallback<List<SheetBooking>> OnEditSeries { get; set; }

    // Additive - defaults to false, so every existing call site (the calendar page) is unchanged.
    // The search page is the only ReadOnly caller today.
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public EventCallback<List<SheetBooking>> OnOpenOnCalendar { get; set; }

    private static string SheetLabel(string sheetMailbox)
    {
        var localPart = sheetMailbox.Split('@')[0];
        var digits = new string(localPart.Where(char.IsDigit).ToArray());
        return digits.Length > 0 ? $"Sheet {digits}" : localPart;
    }
}
