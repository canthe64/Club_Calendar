@using FacilityScheduler.Domain
@using FacilityScheduler.Services
@inject FacilityConfiguration Facility

<div style="min-width:800px;border:1px solid #e7ecef;border-radius:8px;padding:10px;background:#fff">
    <div style="display:flex;gap:3px;font-size:13px">
        <div style="width:56px;flex-shrink:0">
            <div style="height:20px"></div>
            @if (ClubEventBand.Count > 0)
            {
                <div style="height:@(ClubEventBandHeightPx)px"></div>
            }
            @foreach (var hour in CalendarStyles.HourRows)
            {
                <div style="box-sizing:border-box;height:@(CalendarStyles.RowHeightPx)px;color:#90a0ab;font-size:12.5px;text-align:right;padding:2px 8px 0 0;font-weight:600">@CalendarStyles.FormatHour(hour)</div>
                <div style="height:@(CalendarStyles.RowGapPx)px"></div>
            }
        </div>
        @* The hour rails for timed club events, in their own narrow strip rather than over the sheet
           columns. A club event belongs to no sheet, so it has no honest column to occupy - but its
           band row alone can't say WHEN it runs, which is what moving club events into the timeline
           bought in the first place (D19). The rail carries that, and because it lives outside the
           sheet area it can never paint over a booking. Rail colour is exactly its band row's fill -
           the category colour, with no separate treatment for a closure, because the rail's whole
           job is to point at one row of the band. ("All sheets closed" is already carried by that
           row's own label via ClubEventText.) Two concurrent events of the same category are told
           apart by lane position, not by giving one a colour that isn't its category's. *@
        @if (TimedClubEvents.Count > 0)
        {
            <div style="width:@(RailStripWidthPx)px;flex-shrink:0">
                <div style="height:20px"></div>
                <div style="height:@(ClubEventBandHeightPx)px"></div>
                <div style="position:relative;height:@(HourColumnHeightPx)px">
                    @foreach (var laid in CalendarStyles.LayoutLanes(TimedClubEvents, ce => ce.Start, ce => ce.ExclusiveEnd))
                    {
                        var ce = laid.Item;
                        <div title="@ClubEventText(ce, Date)"
                             style="position:absolute;pointer-events:none;top:@(CalendarStyles.TopPx(ce.Start, Date))px;left:@(laid.Lane * (RailWidthPx + RailGapPx))px;width:@(RailWidthPx)px;height:@(CalendarStyles.HeightPx(ce.Start, ce.ExclusiveEnd, Date))px;border-radius:3px;background:@CalendarStyles.ClubEventCategoryColor(ce.Category)"></div>
                    }
                </div>
            </div>
        }
        <div style="flex:1;min-width:0">
            <div style="display:flex;gap:3px">
                @foreach (var sheet in Facility.SheetMailboxes)
                {
                    <div style="flex:1;text-align:center;color:#5a7183;font-weight:600;height:20px">@CalendarStyles.SheetLabel(sheet)</div>
                }
            </div>
            @* One band for every club event on this day, all-day and timed alike. Timed ones used to
               be full-width absolute overlays inside the hourly grid, which meant two overlapping
               club events painted over each other and over every booking underneath (live-found
               2026-08-27). They're rows here instead, so they stack instead of collide; their
               position in time is carried by the rails to the left. *@
            @if (ClubEventBand.Count > 0)
            {
                <div style="display:flex;flex-direction:column;gap:2px;padding:2px 0 4px">
                    @foreach (var ce in ClubEventBand)
                    {
                        <div @onclick="() => OnClubEventClick.InvokeAsync(ce)"
                             style="background:@CalendarStyles.ClubEventCategoryColor(ce.Category);color:#fff;border:@CalendarStyles.ClubEventBorderStyle;box-sizing:border-box;border-radius:4px;padding:3px 8px;font-size:12.5px;font-weight:600;cursor:pointer;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                            @ClubEventText(ce, Date)
                        </div>
                    }
                </div>
            }
            <div style="position:relative">
                <div style="display:flex;gap:3px">
                    @foreach (var sheet in Facility.SheetMailboxes)
                    {
                        <div style="flex:1;min-width:0;position:relative">
                            @foreach (var hour in CalendarStyles.HourRows)
                            {
                                var slotStart = Date.Date.AddHours(hour);
                                <div @onclick="() => OnSlotClick.InvokeAsync((sheet, slotStart))"
                                     style="box-sizing:border-box;height:@(CalendarStyles.RowHeightPx)px;margin-bottom:@(CalendarStyles.RowGapPx)px;border-radius:5px;background:@CalendarStyles.EmptySlotBg;border:1px solid #eef1f3;cursor:pointer">
                                </div>
                            }
                            @* Lane-split rather than a flat full-width foreach: the app's own write-path
                               conflict check should prevent two bookings ever overlapping on the same
                               sheet, but that invariant doesn't protect data written outside the app
                               (direct Graph/Outlook writes, seeded test data) - without this, a wider
                               overlapping booking (e.g. a Hold spanning several hours) would completely
                               paint over a narrower one sharing this same full-width column. Live-found
                               2026-07-28. *@
                            @foreach (var laid in CalendarStyles.LayoutLanes(BookingsForSheet(sheet), b => b.Start, b => b.End))
                            {
                                var booking = laid.Item;
                                var widthPct = 100.0 / laid.LaneCount;
                                var leftPct = laid.Lane * widthPct;
                                // The start time belongs to the booking's actual first day only - on a
                                // later day of a multi-day booking (e.g. the Saturday of a Fri-Sun
                                // booking), showing "9AM - Title" reads as if it starts at 9AM that day
                                // too, rather than continuing from the day before.
                                var isContinuationDay = Date.Date > booking.Start.Date;
                                var titleText = isContinuationDay ? Title(booking) : $"{CalendarStyles.CellStartTimeLabel(booking.Start)} - {Title(booking)}";
                                <div @onclick="() => OnBookingClick.InvokeAsync(booking)"
                                     style="box-sizing:border-box;position:absolute;top:@(CalendarStyles.TopPx(booking.Start, Date))px;left:@(leftPct)%;width:calc(@(widthPct)% - 2px);height:@(CalendarStyles.HeightPx(booking.Start, booking.End, Date))px;z-index:1;border-radius:5px;background:@CalendarStyles.BackgroundStyle(booking);border:@CalendarStyles.BorderStyle(booking);padding:2px 6px;overflow:hidden;cursor:pointer">
                                    <div style="font-size:12.5px;font-weight:600;color:@CalendarStyles.TextColorStyle(booking)">@titleText</div>
                                    <div style="font-size:11.5px;color:@CalendarStyles.TextColorStyle(booking);opacity:.85">@TimeRangeForDay(booking, Date)</div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div style="display:flex;gap:16px;margin-top:12px;font-size:13px;color:#5a7183;flex-wrap:wrap">
        <span><span style="display:inline-block;width:11px;height:11px;border-radius:2px;background:#eaf1f8;border:1.5px dashed #2d5f8a;vertical-align:-2px"></span> Open for group event — click to book</span>
        <span><span style="display:inline-block;width:11px;height:11px;border-radius:2px;background:#2d5f8a;vertical-align:-2px"></span> Booked</span>
        <span><span style="display:inline-block;width:11px;height:11px;border-radius:2px;background:@CalendarStyles.CategoryColor(BookingCategory.League);vertical-align:-2px"></span> League</span>
        <span><span style="display:inline-block;width:11px;height:11px;border-radius:2px;background:@CalendarStyles.CategoryColor(BookingCategory.Event);vertical-align:-2px"></span> Event</span>
        <span><span style="display:inline-block;width:11px;height:11px;border-radius:2px;background:@CalendarStyles.CategoryColor(BookingCategory.Bonspiel);vertical-align:-2px"></span> Bonspiel</span>
        <span><span style="display:inline-block;width:11px;height:11px;border-radius:2px;background:@CalendarStyles.CategoryColor(BookingCategory.Maintenance);vertical-align:-2px"></span> Maintenance</span>
        <span><span style="display:inline-block;width:11px;height:11px;border-radius:2px;background:@CalendarStyles.CategoryColor(BookingCategory.PracticeIce);vertical-align:-2px"></span> Practice Ice</span>
        <span><span style="display:inline-block;width:11px;height:11px;border-radius:2px;background:@CalendarStyles.CategoryColor(BookingCategory.LearnToCurl);vertical-align:-2px"></span> Learn To Curl</span>
        <span><span style="display:inline-block;width:11px;height:11px;border-radius:2px;background:@CalendarStyles.CategoryColor(BookingCategory.Other);vertical-align:-2px"></span> Other</span>
        <span><span style="display:inline-block;width:11px;height:11px;border-radius:2px;background:#6b7680;border:@CalendarStyles.ClubEventBorderStyle;box-sizing:border-box;vertical-align:-2px"></span> Off-ice event — dotted outline</span>
        <span><span style="display:inline-block;width:5px;height:11px;border-radius:2px;background:#6b7680;vertical-align:-2px"></span> When that off-ice event runs</span>
        <span><span style="display:inline-block;width:11px;height:11px;border-radius:2px;background:#f6f8f9;border:1px solid #eef1f3;vertical-align:-2px"></span> No ice time — click to book anyway</span>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public List<SheetBooking> Bookings { get; set; } = [];
    [Parameter] public List<ClubEvent> ClubEvents { get; set; } = [];
    [Parameter, EditorRequired] public DateTime Date { get; set; }
    [Parameter] public EventCallback<SheetBooking> OnBookingClick { get; set; }
    [Parameter] public EventCallback<ClubEvent> OnClubEventClick { get; set; }
    [Parameter] public EventCallback<(string Sheet, DateTime Start)> OnSlotClick { get; set; }

    private const double ClubEventChipHeightPx = 20;
    private const double ClubEventChipGapPx = 2;

    // The rail strip's geometry. Three concurrent club events is already an unusual day, so the
    // strip is sized for that and lets a fourth-plus rail overflow rather than shrinking every rail
    // on every ordinary day to accommodate a case that essentially doesn't happen.
    private const double RailWidthPx = 6;
    private const double RailGapPx = 2;
    private const double RailStripWidthPx = 3 * RailWidthPx + 2 * RailGapPx;

    // CalendarStyles.OccursOnDay(ce.Start, ce.ExclusiveEnd, ...), not a raw ce.End comparison - a
    // timed event ending exactly at midnight has zero real duration on the day .Date would put it on
    // (live-found 2026-08-27); ExclusiveEnd also correctly converts an all-day event's inclusive last
    // day into a real boundary, so the one call handles both without branching here.
    private List<ClubEvent> ActiveClubEvents =>
        ClubEvents.Where(ce => CalendarStyles.OccursOnDay(ce.Start, ce.ExclusiveEnd, Date)).ToList();

    // Every club event on this day, in one band above the hourly grid: all-day first (no hour to
    // sort them by), then timed ones in start order. Timed events used to sit in the timeline itself
    // as full-width overlays; see the band's own comment in the markup for why they moved.
    private List<ClubEvent> ClubEventBand =>
        [
            .. ActiveClubEvents.Where(ce => ce.IsAllDay).OrderBy(ce => ce.Title),
            .. ActiveClubEvents.Where(ce => !ce.IsAllDay).OrderBy(ce => ce.Start)
        ];

    private List<ClubEvent> TimedClubEvents => ActiveClubEvents.Where(ce => !ce.IsAllDay).OrderBy(ce => ce.Start).ToList();

    private double ClubEventBandHeightPx =>
        ClubEventBand.Count * ClubEventChipHeightPx + Math.Max(0, ClubEventBand.Count - 1) * ClubEventChipGapPx + 6;

    // The rails are absolutely positioned against their own container, so it has to be exactly as
    // tall as the hour rows it sits beside - each row is a cell plus the gap below it.
    private static double HourColumnHeightPx => CalendarStyles.HourRows.Length * CalendarStyles.PxPerHour;

    // Purely informational - no change to sheet booking/conflict logic here, matching the Club
    // Events architecture decision D13 ("no cross-check in either direction").
    private static string ClubEventText(ClubEvent ce, DateTime day)
    {
        if (ce.IsAllDay)
        {
            return ce.MarksSheetsUnavailable ? $"{ce.Title} - all sheets closed" : ce.Title;
        }

        // Same reasoning as booking titles: ce.Start belongs to the event's actual first day only -
        // on a later day of a multi-day timed club event, prefixing it here would read as if it
        // starts that day too.
        var titleWithTime = day.Date == ce.Start.Date ? $"{CalendarStyles.CellStartTimeLabel(ce.Start)} - {ce.Title}" : ce.Title;
        return ce.MarksSheetsUnavailable ? $"{titleWithTime} - all sheets closed" : titleWithTime;
    }

    private List<SheetBooking> BookingsForSheet(string sheet) =>
        Bookings.Where(b => b.SheetMailbox == sheet).ToList();

    private static string Title(SheetBooking b) => string.IsNullOrWhiteSpace(b.RenterName) ? CalendarStyles.CategoryLabel(b.Category) : b.RenterName;

    // Same reasoning as the title above: b.Start/b.End are the booking's overall boundaries, not
    // necessarily anything to do with the day being rendered. Only state a boundary time this chip
    // is actually showing on this day - a middle day of a multi-day booking runs the entire day, so
    // neither boundary applies and it reads as "All day" rather than a fabricated 9AM-4PM.
    private static string TimeRangeForDay(SheetBooking b, DateTime day)
    {
        var showsStart = day.Date == b.Start.Date;
        var showsEnd = day.Date == b.End.Date;

        return (showsStart, showsEnd) switch
        {
            (true, true) => $"{b.Start:h:mmtt}-{b.End:h:mmtt}",
            (true, false) => $"{b.Start:h:mmtt} →",
            (false, true) => $"→ {b.End:h:mmtt}",
            _ => "All day"
        };
    }
}
