@using FacilityScheduler.Domain

<div style="display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:5px;font-size:11px;min-width:900px">
    @foreach (var name in DowNames)
    {
        <div style="text-align:center;color:#90a0ab;font-weight:600;padding:3px 0;font-size:11.5px">@name</div>
    }
    @foreach (var cell in MonthCells)
    {
        var inMonth = cell.Month == AnchorMonth.Month;
        <div @onclick="() => OnDayClick.InvokeAsync(cell)"
             style="border:1px solid #e7ecef;border-radius:6px;min-height:112px;padding:4px 5px;background:@(inMonth ? "#fff" : "#fafbfc");cursor:pointer">
            <div style="font-size:11px;color:@(inMonth ? "#90a0ab" : "#c1ccd4");font-weight:600;padding:1px 2px">@cell.Day</div>
            @{
                var dayClubEvents = ClubEvents.Where(ce => ce.Start.Date <= cell.Date && cell.Date <= ce.End.Date).ToList();
                var dayBookings = Bookings
                    .Where(b => b.Start.Date == cell.Date)
                    .GroupBy(DedupeKey)
                    .Select(g => g.First())
                    .ToList();
                var dayItems = CombineForDay(dayClubEvents, dayBookings, cell.Date);
                var isExpanded = _expandedDays.Contains(cell.Date);
                var visibleItems = isExpanded ? dayItems : dayItems.Take(3).ToList();
            }
            @foreach (var item in visibleItems)
            {
                @if (item.ClubEvent is { } ce)
                {
                    <div @onclick="() => OnClubEventClick.InvokeAsync(ce)" @onclick:stopPropagation="true"
                         style="background:@CalendarStyles.ClubEventCategoryColor(ce.Category);color:#fff;border:@CalendarStyles.ClubEventBorderStyle;box-sizing:border-box;border-radius:3px;padding:2px 5px;margin-top:2px;font-size:10px;font-weight:600;white-space:nowrap;overflow:hidden;cursor:pointer">
                        @ClubEventTitle(ce)
                    </div>
                }
                else if (item.Booking is { } b)
                {
                    <div @onclick="() => OnBookingClick.InvokeAsync(b)" @onclick:stopPropagation="true"
                         style="background:@CalendarStyles.BackgroundStyle(b);color:@CalendarStyles.TextColorStyle(b);border:@CalendarStyles.BorderStyle(b);border-radius:3px;padding:2px 5px;margin-top:2px;font-size:10px;font-weight:600;white-space:nowrap;overflow:hidden">
                        @BookingTitle(b)
                    </div>
                }
            }
            @if (!isExpanded && dayItems.Count > 3)
            {
                <div @onclick="() => ExpandDay(cell.Date)" @onclick:stopPropagation="true"
                     style="color:#90a0ab;margin-top:2px;padding:0 2px;cursor:pointer;text-decoration:underline">+@(dayItems.Count - 3) more</div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public List<SheetBooking> Bookings { get; set; } = [];
    [Parameter] public List<ClubEvent> ClubEvents { get; set; } = [];
    [Parameter, EditorRequired] public DateTime AnchorMonth { get; set; }
    [Parameter] public EventCallback<SheetBooking> OnBookingClick { get; set; }
    [Parameter] public EventCallback<ClubEvent> OnClubEventClick { get; set; }
    [Parameter] public EventCallback<DateTime> OnDayClick { get; set; }

    private static readonly string[] DowNames = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];

    // Which day cells have had their "+N more" expanded to show every item. Resets naturally when
    // this component is torn down (switching away from Month view, or navigating to a different
    // month reloads the page's data but keeps the same component instance - deliberately left
    // expanded across a Prev/Next/Today navigation within Month view, only clearing on remount).
    private readonly HashSet<DateTime> _expandedDays = [];

    private void ExpandDay(DateTime date) => _expandedDays.Add(date);

    private IEnumerable<DateTime> MonthCells
    {
        get
        {
            var firstOfMonth = new DateTime(AnchorMonth.Year, AnchorMonth.Month, 1);
            var gridStart = firstOfMonth.AddDays(-(int)firstOfMonth.DayOfWeek);
            var lastOfMonth = firstOfMonth.AddMonths(1).AddDays(-1);
            var gridEnd = lastOfMonth.AddDays(6 - (int)lastOfMonth.DayOfWeek);

            for (var d = gridStart; d <= gridEnd; d = d.AddDays(1))
            {
                yield return d;
            }
        }
    }

    private static string Title(SheetBooking b) => string.IsNullOrWhiteSpace(b.RenterName) ? CalendarStyles.CategoryLabel(b.Category) : b.RenterName;

    private static string BookingTitle(SheetBooking b) => $"{CalendarStyles.CellStartTimeLabel(b.Start)} - {Title(b)}";

    // All-day events have no specific hour to show; timed ones get the same start-time prefix as bookings.
    private static string ClubEventTitle(ClubEvent ce) => ce.IsAllDay ? ce.Title : $"{CalendarStyles.CellStartTimeLabel(ce.Start)} - {ce.Title}";

    // BookingGroupId doesn't reliably read back for untouched occurrences of a recurring series
    // (only set on the series master, not proven to inherit down to occurrences) - they default to
    // Guid.Empty. Grouping directly on that would incorrectly merge multiple UNRELATED bookings that
    // all happen to share the same empty default into one, hiding all but one. Falling back to
    // (SheetMailbox, EventId) - always unique per booking - for the empty case means only bookings
    // that share a genuine, real group id ever get merged.
    private static string DedupeKey(SheetBooking b) =>
        b.BookingGroupId != Guid.Empty ? b.BookingGroupId.ToString() : $"{b.SheetMailbox}|{b.EventId}";

    // Merges a day's club events and bookings into one chronologically-ordered list. All-day club
    // events sort as if occurring at midnight (first), so they consistently anchor to the top of the
    // day rather than landing wherever their arbitrary Start happens to fall; timed club events and
    // bookings interleave by their actual Start.
    private static List<(ClubEvent? ClubEvent, SheetBooking? Booking)> CombineForDay(
        List<ClubEvent> clubEvents, List<SheetBooking> bookings, DateTime cellDate)
    {
        var events = clubEvents.Select(ce => (SortKey: ce.IsAllDay ? cellDate : ce.Start, ClubEvent: (ClubEvent?)ce, Booking: (SheetBooking?)null));
        var books = bookings.Select(b => (SortKey: b.Start, ClubEvent: (ClubEvent?)null, Booking: (SheetBooking?)b));
        return events.Concat(books).OrderBy(i => i.SortKey).Select(i => (i.ClubEvent, i.Booking)).ToList();
    }
}
