@inherits LayoutComponentBase
@using FacilityScheduler.Services
@inject SchedulingWindowService Window
@inject FacilityConfiguration Facility

<header class="app-header">
    @* Wraps the trigger and the panel so the panel can position itself against the button. *@
    <div class="app-menu">
        <button type="button" class="app-menu-button" @onclick="ToggleMenu"
                aria-label="Menu" aria-haspopup="true" aria-expanded="@_menuOpen">
            <span class="app-menu-bar"></span>
            <span class="app-menu-bar"></span>
            <span class="app-menu-bar"></span>
        </button>

        @if (_menuOpen)
        {
            @* Full-viewport transparent backdrop: gives "click anywhere else to dismiss" without
               needing a JS document-level listener, and sits under the panel in z-order. *@
            <div class="app-menu-backdrop" @onclick="CloseMenu"></div>
            <nav class="app-menu-panel">
                @foreach (var item in MenuItems)
                {
                    @if (item.StaffOnly)
                    {
                        @* Bound to the real registered policy rather than re-checking the claim by
                           hand - a second copy of the rule is exactly how the D75 lockout happened.
                           Renders nothing at all for a non-staff member, so they don't see a link
                           that would only deny them. *@
                        <AuthorizeView Policy="@StaffAuthorizationPolicies.StaffOnly" Context="staffOnly">
                            <Authorized>
                                <a href="@item.Href" target="@(item.NewTab ? "_blank" : null)" @onclick="CloseMenu">@item.Label</a>
                            </Authorized>
                        </AuthorizeView>
                    }
                    else
                    {
                        <a href="@item.Href" target="@(item.NewTab ? "_blank" : null)" @onclick="CloseMenu">@item.Label</a>
                    }
                }
                <a href="MicrosoftIdentity/Account/SignOut" class="app-menu-signout" @onclick="CloseMenu">Sign out</a>
            </nav>
        }
    </div>

    <div class="app-heading">
        <div class="app-title">GCC Ice &amp; Event Calendar</div>
        <AuthorizeView>
            <Authorized>
                @* DisplayName(), not Identity.Name - the latter is the UPN on an Entra token (D71). *@
                <div class="app-greeting">Hello, @context.User.DisplayName()</div>
            </Authorized>
        </AuthorizeView>
    </div>
</header>

@* Staff-only reminder that the public calendar's cutoff is approaching or has passed - not shown
   to the one non-staff authenticated page (/practice-ice/request) that shares this layout, same
   AuthorizeView gating the menu items above already use. Deliberately stays visible past the
   cutoff date itself, not just during the 30-day countdown - a season quietly staying hidden with
   nobody having updated it is worth flagging for longer than a one-time heads-up (operator
   decision). Settings has no equivalent banner for the season start/end window. *@
<AuthorizeView Policy="@StaffAuthorizationPolicies.StaffOnly" Context="cutoffBanner">
    <Authorized>
        @if (Window.PublicCutoffDate is { } cutoff && ShouldShowCutoffBanner(cutoff, Facility.Today))
        {
            <div style="margin:10px 24px 0;padding:8px 12px;border:1px solid #f0d58c;background:#fdf8ec;border-radius:6px;color:#8a6d1f;font-size:13px">
                @CutoffBannerMessage(cutoff, Facility.Today) <a href="/settings" style="color:#8a6d1f;font-weight:600">Update in Settings</a>.
            </div>
        }
    </Authorized>
</AuthorizeView>

@* Catches an unhandled exception thrown from a page's own event handler (e.g. a Graph 404, a bad
   input like a negative number reaching a service call) so it shows a recoverable in-page message
   instead of crashing the whole SignalR circuit - previously every such error surfaced as the
   generic "unhandled error" banner below, which requires reloading the entire app and had already
   been hit twice this project (a 404 from a stale view, an inverted booking time range). This
   doesn't replace input validation; it's the backstop for whatever validation misses. *@
<ErrorBoundary @ref="_errorBoundary">
    <ChildContent>
        @Body
    </ChildContent>
    <ErrorContent Context="ex">
        <div style="margin:16px 24px;padding:14px 18px;border:1px solid #e8b4ae;background:#fdf3f1;border-radius:8px;color:#a02c21;font-size:13px">
            <strong>Something went wrong loading this page.</strong>
            <span style="color:#5a7183">This is usually transient - try again.</span>
            <button class="btn btn-secondary" style="margin-left:10px" @onclick="Recover">Try again</button>
        </div>
    </ErrorContent>
</ErrorBoundary>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private ErrorBoundary? _errorBoundary;
    private bool _menuOpen;

    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void CloseMenu() => _menuOpen = false;

    private sealed record MenuItem(string Label, string Href, bool NewTab = false, bool StaffOnly = false);

    // StaffOnly mirrors what each destination's own authorization actually enforces (§6.5): the two
    // anonymous public pages are reachable by anyone, everything else sits behind the staff-only
    // fallback policy. A non-staff member - someone guest-invited purely to request practice ice -
    // is left with Public Calendar, Practice Ice and Sign out, which is the whole of what they can
    // actually use. Hiding is presentation only; the pages enforce their own access regardless.
    //
    // The two anonymous surfaces open in a new tab so a staff member checking what members see
    // doesn't lose their place in the app; everything else navigates in place.
    private static readonly MenuItem[] MenuItems =
    [
        new("Staff Calendar", "/calendar", StaffOnly: true),
        new("Public Calendar", "/public/calendar", NewTab: true),
        new("Off-Ice Events", "/club-events", StaffOnly: true),
        new("Search", "/search", StaffOnly: true),
        new("Practice Ice", "/public/practice-ice", NewTab: true),
        new("Practice Ice Approvals", "/practice-ice/approvals", StaffOnly: true),
        new("Settings", "/settings", StaffOnly: true)
    ];

    // Resets the boundary so the page's own OnInitializedAsync (etc.) runs again in place, rather
    // than forcing a full browser reload the way the circuit-level error banner above does.
    private void Recover() => _errorBoundary?.Recover();

    // internal static, not private, so these are directly unit-testable via InternalsVisibleTo -
    // same reasoning as PublicCalendarEndpoint.ResolveMonthAnchor: pure date math pulled out of
    // markup rather than asserted only through a full render.
    internal static bool ShouldShowCutoffBanner(DateTime cutoff, DateTime today) => today >= cutoff.AddDays(-30);

    internal static string CutoffBannerMessage(DateTime cutoff, DateTime today)
    {
        var days = (cutoff.Date - today.Date).Days;
        var when = days switch
        {
            > 0 => $"{days} day{(days == 1 ? "" : "s")} from today",
            0 => "today",
            _ => $"{-days} day{(-days == 1 ? "" : "s")} ago",
        };
        return $"The public calendar only shows bookings through {cutoff:MMM d, yyyy} ({when}).";
    }
}
