@inherits LayoutComponentBase

<header class="app-header">
    <span class="app-title">Facility Scheduler</span>
    <a href="calendar">Calendar</a>
    <a href="club-events">Club Events</a>
    <a href="schedule">Single-sheet (legacy)</a>
    <a href="diagnostics">Diagnostics</a>
    <a href="settings">Settings</a>
    <AuthorizeView>
        <Authorized>
            <span class="user-name">@context.User.Identity?.Name</span>
            <a href="MicrosoftIdentity/Account/SignOut">Sign out</a>
        </Authorized>
    </AuthorizeView>
</header>

@Body

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
